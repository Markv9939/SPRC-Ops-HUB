rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================================
    // CLAIM-SCOPE STAGED AUTH MODEL (FREE-TIER V1)
    // ============================================================================
    // Current login remains PIN-based, with optional Firebase Auth session bootstrap.
    // In hybrid mode, auth claim checks are enforced when scope claims are present
    // (`role`, `locations`) on the Firebase Auth token.
    // Strict mode is controlled by appSettings/security.authScopeEnforced.
    // PIN storage is hash-only (`pinHash`) and plaintext PIN fallback is retired.
    // ============================================================================

    // Helper: prevent createdAt from being changed after creation
    function createdAtUnchanged() {
      return !('createdAt' in resource.data)
             || request.resource.data.createdAt == resource.data.createdAt;
    }

    function validRole(role) {
      return role in ['tech', 'supervisor', 'admin'];
    }

    function authScopeEnforced() {
      return exists(/databases/$(database)/documents/appSettings/security)
        && get(/databases/$(database)/documents/appSettings/security).data.authScopeEnforced == true;
    }

    function hasAuthScopeClaims() {
      return request.auth != null
        && request.auth.token.role is string
        && request.auth.token.locations is list;
    }

    function authRole() {
      return hasAuthScopeClaims() ? request.auth.token.role : '';
    }

    function authLocations() {
      return hasAuthScopeClaims() ? request.auth.token.locations : [];
    }

    function authRoleAllowed(roles) {
      return authScopeEnforced()
        ? (hasAuthScopeClaims() && authRole() in roles)
        : (!hasAuthScopeClaims() || authRole() in roles);
    }

    // Map house location IDs to supervisor site scopes used in auth claims.
    function locationScopeAlias(locationId) {
      return locationId == 'mesquite' || locationId == 'MESQUITE'
        ? 'PHP'
        : (
            locationId == 'res' || locationId == 'RES'
              ? 'PHP'
              : (
                  locationId == 'lone_mountain' || locationId == 'LONE_MOUNTAIN'
                    ? 'RTC'
                    : locationId
                )
          );
    }

    function authLocationAllowed(locationId) {
      return authScopeEnforced()
        ? (hasAuthScopeClaims()
            && (
              authRole() == 'admin'
              || locationId in authLocations()
              || locationScopeAlias(locationId) in authLocations()
            ))
        : (!hasAuthScopeClaims()
            || authRole() == 'admin'
            || locationId in authLocations()
            || locationScopeAlias(locationId) in authLocations());
    }

    function authRoleAndLocationAllowed(roles, locationId) {
      return authRoleAllowed(roles) && authLocationAllowed(locationId);
    }

    function validUserWriteData(data) {
      return data.keys().hasAll(['name', 'pinHash', 'role', 'active'])
        && data.name is string
        && data.pinHash is string
        && data.pinHash.size() >= 32
        && validRole(data.role)
        && data.active is bool
        && (!('site' in data) || data.site is string)
        && (!('authorizedLocations' in data) || data.authorizedLocations is list)
        && (!('pin' in data) || data.pin is string);
    }

    function validAccessGrantWriteData(data) {
      return data.keys().hasAll([
        'userId', 'userName', 'locationId', 'startsAt', 'expiresAt',
        'reason', 'revoked', 'revokedAt', 'revokedReason',
        'createdByUserId', 'createdByName'
      ])
        && data.userId is string
        && data.userName is string
        && data.locationId is string
        && data.startsAt is timestamp
        && data.expiresAt is timestamp
        && data.reason is string
        && data.reason.size() > 0
        && data.revoked is bool
        && (data.revokedAt == null || data.revokedAt is timestamp)
        && (data.revokedReason == null || data.revokedReason is string)
        && data.createdByUserId is string
        && data.createdByName is string
        && (
          data.revoked != true
          || (data.revokedReason is string && data.revokedReason.size() > 0)
        );
    }

    function validVersionField(data) {
      return !('version' in data) || data.version is int;
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;

      allow create: if validUserWriteData(request.resource.data)
        && authRoleAllowed(['admin'])
        && validVersionField(request.resource.data);

      allow update: if validUserWriteData(request.resource.data)
        && authRoleAllowed(['admin'])
        && validVersionField(request.resource.data)
        && createdAtUnchanged();

      allow delete: if authRoleAllowed(['admin']);
    }

    // Clients collection (autocomplete suggestions)
    match /clients/{clientId} {
      allow read, write: if true;
    }

    // Destinations collection (autocomplete suggestions)
    match /destinations/{destinationId} {
      allow read, write: if true;
    }

    // BHT Assignments collection
    match /shiftAssignments/{docId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasAll([
        'bhtUserId', 'bhtUserName', 'locationId', 'shiftId', 'vanIds',
        'isHousePrimary', 'active'
      ])
        && request.resource.data.bhtUserId is string
        && request.resource.data.locationId is string
        && request.resource.data.shiftId is string
        && request.resource.data.vanIds is list
        && request.resource.data.isHousePrimary is bool
        && request.resource.data.active is bool
        && authRoleAndLocationAllowed(['supervisor', 'admin'], request.resource.data.locationId)
        && validVersionField(request.resource.data);

      allow update: if createdAtUnchanged()
        && authRoleAndLocationAllowed(['supervisor', 'admin'], request.resource.data.locationId)
        && validVersionField(request.resource.data);
      allow delete: if authRoleAndLocationAllowed(['supervisor', 'admin'], resource.data.locationId);
    }

    // EOC Tasks collection
    match /eocTasks/{docId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasAll([
        'taskType', 'locationId', 'shiftId', 'assigneeUserId',
        'dueDate', 'status', 'cycleKey'
      ])
        && request.resource.data.taskType in ['house', 'van']
        && request.resource.data.status in ['pending', 'overdue', 'completed']
        && authRoleAndLocationAllowed(['tech', 'supervisor', 'admin'], request.resource.data.locationId)
        && validVersionField(request.resource.data);

      allow update: if request.resource.data.status in ['pending', 'overdue', 'completed']
        && authRoleAndLocationAllowed(['tech', 'supervisor', 'admin'], request.resource.data.locationId)
        && validVersionField(request.resource.data)
        && createdAtUnchanged();

      allow delete: if authRoleAndLocationAllowed(['supervisor', 'admin'], resource.data.locationId);
    }

    // EOC Assignments (legacy — kept for historical data)
    match /eocAssignments/{docId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasAll([
        'locationId', 'shiftId', 'dueDate', 'assignedTechId', 'eocType', 'status'
      ])
        && authRoleAndLocationAllowed(['supervisor', 'admin'], request.resource.data.locationId);

      allow update: if createdAtUnchanged()
        && authRoleAndLocationAllowed(['supervisor', 'admin'], request.resource.data.locationId);
      allow delete: if authRoleAndLocationAllowed(['supervisor', 'admin'], resource.data.locationId);
    }

    // EOC Submissions
    match /eocSubmissions/{docId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasAll([
        'locationId', 'shiftId', 'eocType', 'submittedByUserId', 'submittedByName'
      ])
        && authRoleAndLocationAllowed(['tech', 'supervisor', 'admin'], request.resource.data.locationId)
        && validVersionField(request.resource.data);

      allow update: if createdAtUnchanged()
        && authRoleAndLocationAllowed(['supervisor', 'admin'], request.resource.data.locationId)
        && validVersionField(request.resource.data);
      allow delete: if authRoleAndLocationAllowed(['admin'], resource.data.locationId);
    }

    // EOC Issues
    match /eocIssues/{docId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasAll([
        'locationId', 'eocType', 'label', 'status', 'reportedByUserId'
      ])
        && request.resource.data.status == 'open'
        && authRoleAndLocationAllowed(['tech', 'supervisor', 'admin'], request.resource.data.locationId)
        && validVersionField(request.resource.data);

      allow update: if request.resource.data.status in ['open', 'in_progress', 'resolved']
        && authRoleAndLocationAllowed(['supervisor', 'admin'], request.resource.data.locationId)
        && validVersionField(request.resource.data)
        && (
          request.resource.data.status != 'resolved'
          || (
            request.resource.data.keys().hasAny(['resolvedNotes'])
            && request.resource.data.resolvedNotes is string
            && request.resource.data.resolvedNotes.size() > 0
          )
        )
        && createdAtUnchanged();
      allow delete: if authRoleAndLocationAllowed(['admin'], resource.data.locationId);
    }

    // Supervisor Alerts
    match /alerts/{docId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasAll([
        'type', 'message', 'read'
      ])
        && request.resource.data.read is bool
        && authRoleAndLocationAllowed(['tech', 'supervisor', 'admin'], request.resource.data.locationId)
        && validVersionField(request.resource.data);

      allow update: if createdAtUnchanged()
        && authRoleAndLocationAllowed(['supervisor', 'admin'], request.resource.data.locationId)
        && validVersionField(request.resource.data);
      allow delete: if authRoleAndLocationAllowed(['admin'], resource.data.locationId);
    }

    // Access Grants (temporary backup location access lifecycle)
    match /accessGrants/{docId} {
      allow read: if true;

      allow create: if validAccessGrantWriteData(request.resource.data)
        && authRoleAllowed(['admin'])
        && validVersionField(request.resource.data);

      allow update: if validAccessGrantWriteData(request.resource.data)
        && authRoleAllowed(['admin'])
        && validVersionField(request.resource.data)
        && createdAtUnchanged();

      allow delete: if false;
    }

    // Audit Logs
    match /auditLogs/{docId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasAll([
        'action', 'collectionPath', 'documentId',
        'performedByUserId', 'performedByName', 'reason'
      ])
        && authRoleAllowed(['tech', 'supervisor', 'admin'])
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && validVersionField(request.resource.data);

      allow update: if false;
      allow delete: if false;
    }

    // EOC Checklist Template
    match /eocChecklistTemplate/{docId} {
      allow read: if true;
      allow write: if authRoleAllowed(['admin']);
    }

    // EOC Template Drafts (Draft -> Diff -> Publish workflow)
    match /eocTemplateDrafts/{docId} {
      allow read: if true;
      allow write: if authRoleAllowed(['admin']);
    }

    // EOC Template Version History
    match /eocTemplateVersions/{docId} {
      allow read: if true;
      allow write: if authRoleAllowed(['admin']);
    }

    // EOC Vehicles
    match /eocVehicles/{docId} {
      allow read: if true;
      allow write: if authRoleAllowed(['admin']);
    }

    // Compliance collections
    match /complianceEmployees/{employeeId} {
      allow read: if true;
      allow write: if authRoleAllowed(['supervisor', 'admin']);
    }
    match /complianceItems/{itemId} {
      allow read: if true;
      allow create, update: if authRoleAndLocationAllowed(['supervisor', 'admin'], request.resource.data.employeeSite);
      allow delete: if authRoleAndLocationAllowed(['supervisor', 'admin'], resource.data.employeeSite);
    }
    match /cintasServices/{serviceId} {
      allow read: if true;
      allow write: if authRoleAllowed(['supervisor', 'admin']);
    }

    // Transports collection
    match /transports/{transportId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasAll([
        'site', 'createdByUserId', 'createdByName', 'status', 'departedAt', 'createdAt'
      ])
        && request.resource.data.status in ['open', 'arrived', 'returned', 'closed']
        && request.resource.data.site in ['PHP', 'RTC']
        && authRoleAndLocationAllowed(['tech', 'supervisor', 'admin'], request.resource.data.site)
        && validVersionField(request.resource.data);

      allow update: if request.resource.data.keys().hasAll([
        'site', 'createdByUserId', 'createdByName', 'status', 'departedAt', 'updatedAt'
      ])
        && request.resource.data.status in ['open', 'arrived', 'returned', 'closed']
        && authRoleAndLocationAllowed(['tech', 'supervisor', 'admin'], request.resource.data.site)
        && validVersionField(request.resource.data)
        && request.resource.data.createdByUserId == resource.data.createdByUserId
        && request.resource.data.createdByName == resource.data.createdByName
        && request.resource.data.site == resource.data.site
        && createdAtUnchanged()
        && (
          !(request.resource.data.status in ['returned', 'closed'])
          || (
            request.resource.data.keys().hasAny(['dcPaperworkStatus'])
            && request.resource.data.dcPaperworkStatus in ['collected', 'na', 'other']
            && (
              request.resource.data.dcPaperworkStatus != 'other'
              || (request.resource.data.keys().hasAny(['dcPaperworkOtherNote'])
                  && request.resource.data.dcPaperworkOtherNote is string
                  && request.resource.data.dcPaperworkOtherNote.size() > 0)
            )
          )
        );

      allow delete: if authRoleAllowed(['admin']);
    }

    // App settings
    match /appSettings/{docId} {
      allow read: if true;
      allow write: if authRoleAllowed(['admin']);
    }

    // Deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

