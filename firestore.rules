rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================================
    // PIN-COMPATIBLE AUTH MODEL
    // ============================================================================
    // PIN mode uses the application-selected `users/{id}` profile. Strict mapped
    // Firebase Auth remains available behind `authScopeEnforced` for rollback.
    // ============================================================================

    // Helper: prevent createdAt from being changed after creation
    function createdAtUnchanged() {
      return !('createdAt' in resource.data)
             || request.resource.data.createdAt == resource.data.createdAt;
    }

    function validRole(role) {
      return role in ['bht', 'supervisor', 'admin', 'tech'];
    }

    function roleIsBht(role) {
      return role == 'bht' || role == 'tech';
    }

    function normalizedMainLocation(locationId) {
      return (
        locationId == 'OTC'
        || locationId == 'PHP'
        || locationId == 'RTC'
      )
        ? 'OTC'
        : (
            locationId == 'RES'
              ? 'RES'
              : ''
          );
    }

    function validMainLocation(locationId) {
      return normalizedMainLocation(locationId) != '';
    }

    function validHouseId(houseId) {
      return houseId in ['MESQUITE', 'LONE_MOUNTAIN', 'TEST_HOUSE'];
    }

    function validVanId(vanId) {
      return vanId in ['van_1', 'van_2', 'van_3', 'van_4', 'van_test'];
    }

    function validShiftId(shiftId) {
      return shiftId in [
        'shift_1',
        'shift_2',
        'res_shift_1_day',
        'res_shift_1_night',
        'res_shift_2_day',
        'res_shift_2_night'
      ];
    }

    function validTemplateScope(templateScope) {
      return templateScope in ['otc_shared', 'res_day', 'res_night'];
    }

    function validShiftForMainLocation(mainLocation, shiftId) {
      return (
        (mainLocation == 'OTC' && shiftId in ['shift_1', 'shift_2'])
        || (
          mainLocation == 'RES'
          && shiftId in ['res_shift_1_day', 'res_shift_1_night', 'res_shift_2_day', 'res_shift_2_night']
        )
      );
    }

    function normalizedShiftMainLocation(locationId) {
      return (
        locationId == 'mesquite'
        || locationId == 'MESQUITE'
        || locationId == 'lone_mountain'
        || locationId == 'LONE_MOUNTAIN'
        || locationId == 'test_house'
        || locationId == 'TEST_HOUSE'
        || locationId == 'OTC'
        || locationId == 'PHP'
        || locationId == 'RTC'
      )
        ? 'OTC'
        : (
            locationId == 'res'
            || locationId == 'RES'
              ? 'RES'
              : normalizedMainLocation(locationId)
          );
    }

    function validShiftForLocation(locationId, shiftId) {
      return validShiftId(shiftId)
        && validShiftForMainLocation(normalizedShiftMainLocation(locationId), shiftId);
    }

    function userLocationValue(data) {
      return ('location' in data) ? data.location : (('site' in data) ? data.site : '');
    }

    function validBhtWriteData(data) {
      let mainLocation = normalizedMainLocation(userLocationValue(data));
      return roleIsBht(data.role)
        && (
          (data.deleted == true && data.active == false)
          || (
            validMainLocation(userLocationValue(data))
            && data.vanId is string
            && validVanId(data.vanId)
            && data.shiftId is string
            && validShiftForMainLocation(mainLocation, data.shiftId)
            && data.locationId is string
            && (
              mainLocation == 'OTC'
                ? (
                  data.house is string
                  && validHouseId(data.house)
                  && data.locationId in ['mesquite', 'lone_mountain', 'test_house']
                  && data.vanId in ['van_1', 'van_2', 'van_4', 'van_test']
                )
                : (
                  mainLocation == 'RES'
                  && data.locationId == 'res'
                  && data.vanId == 'van_3'
                  && (
                    !('house' in data)
                    || data.house == null
                    || data.house == ''
                  )
                )
              )
            )
          );
    }

    function validSupervisorWriteData(data) {
      return data.role == 'supervisor'
        && (
          (data.deleted == true && data.active == false)
          || validMainLocation(userLocationValue(data))
        )
        && (
          !('house' in data)
          || data.house == null
          || data.house == ''
        )
        && (
          !('vanId' in data)
          || data.vanId == null
          || data.vanId == ''
        );
    }

    function validAdminWriteData(data) {
      return data.role == 'admin'
        && userLocationValue(data) == 'GLOBAL';
    }

    function signedIn() {
      return request.auth != null;
    }

    function hasAuthScopeClaims() {
      return signedIn()
        && request.auth.token.role is string
        && request.auth.token.locations is list;
    }

    function authScopeEnforced() {
      return exists(/databases/$(database)/documents/appSettings/authPolicy)
        && get(/databases/$(database)/documents/appSettings/authPolicy).data.authScopeEnforced == true;
    }

    function hasLegacyAuthSession() {
      return !authScopeEnforced();
    }

    function authEmail() {
      return signedIn() && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }

    function authEmailVerified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function hasAuthUidMapping() {
      return signedIn()
        && exists(/databases/$(database)/documents/usersByAuthUid/$(request.auth.uid));
    }

    function authAppUserId() {
      return hasAuthUidMapping()
        ? get(/databases/$(database)/documents/usersByAuthUid/$(request.auth.uid)).data.userId
        : '';
    }

    function hasActiveAuthProfile() {
      return hasAuthUidMapping()
        && exists(/databases/$(database)/documents/users/$(authAppUserId()))
        && get(/databases/$(database)/documents/users/$(authAppUserId())).data.active == true
        && (
          !('deleted' in get(/databases/$(database)/documents/users/$(authAppUserId())).data)
          || get(/databases/$(database)/documents/users/$(authAppUserId())).data.deleted != true
        );
    }

    function authProfile() {
      return get(/databases/$(database)/documents/users/$(authAppUserId())).data;
    }

    function authRole() {
      return hasActiveAuthProfile() ? authProfile().role : '';
    }

    function authLocations() {
      return hasActiveAuthProfile() && authProfile().authorizedLocations is list
        ? authProfile().authorizedLocations
        : [];
    }

    function activeAuthProfileLocations() {
      return hasActiveAuthProfile() && authProfile().authorizedLocations is list
        ? authProfile().authorizedLocations
        : [];
    }

    function authIssueLocations() {
      return hasActiveAuthProfile() && authProfile().issueLocationIds is list
        ? authProfile().issueLocationIds
        : [];
    }

    function authRoleAllowed(roles) {
      return hasLegacyAuthSession()
        || (hasActiveAuthProfile() && authProfile().role in roles);
    }

    // Map house location IDs to supervisor site scopes used in auth claims.
    function locationScopeAlias(locationId) {
      return (
        locationId == 'mesquite'
        || locationId == 'MESQUITE'
        || locationId == 'lone_mountain'
        || locationId == 'LONE_MOUNTAIN'
        || locationId == 'test_house'
        || locationId == 'TEST_HOUSE'
        || locationId == 'OTC'
        || locationId == 'PHP'
        || locationId == 'RTC'
      )
        ? 'OTC'
        : (
            locationId == 'res' || locationId == 'RES'
              ? 'RES'
              : locationId
          );
    }

    function authLocationAllowed(locationId) {
      let normalizedLocation = locationScopeAlias(locationId);
      let legacyLocationAllowed = (
        (normalizedLocation == 'OTC' && ('PHP' in authLocations() || 'RTC' in authLocations()))
        || (normalizedLocation == 'RES' && ('PHP' in authLocations()))
      );
      return hasLegacyAuthSession() || (
        hasActiveAuthProfile()
        && (
          authRole() == 'admin'
          || locationId in authLocations()
          || normalizedLocation in authLocations()
          || legacyLocationAllowed
        )
      );
    }

    function authRoleAndLocationAllowed(roles, locationId) {
      let normalizedLocation = locationScopeAlias(locationId);
      let locations = activeAuthProfileLocations();
      let legacyLocationAllowed = (
        (normalizedLocation == 'OTC' && ('PHP' in locations || 'RTC' in locations))
        || (normalizedLocation == 'RES' && ('PHP' in locations))
      );
      return hasLegacyAuthSession() || (hasActiveAuthProfile()
        && authProfile().role in roles
        && (
          authProfile().role == 'admin'
          || locationId in locations
          || normalizedLocation in locations
          || legacyLocationAllowed
        ));
    }

    function authTransportLocationAllowed(locationId) {
      let normalizedLocation = locationScopeAlias(locationId);
      let locations = activeAuthProfileLocations();
      let legacyLocationAllowed = (
        (normalizedLocation == 'OTC' && ('PHP' in locations || 'RTC' in locations))
        || (normalizedLocation == 'RES' && ('PHP' in locations))
      );
      let otcHouseScopeAllowed = normalizedLocation == 'OTC'
        && (
          'MESQUITE' in locations
          || 'mesquite' in locations
          || 'LONE_MOUNTAIN' in locations
          || 'lone_mountain' in locations
          || 'TEST_HOUSE' in locations
          || 'test_house' in locations
        );
      let resScopeAllowed = normalizedLocation == 'RES'
        && 'res' in locations;
      return locationId in locations
        || normalizedLocation in locations
        || legacyLocationAllowed
        || otcHouseScopeAllowed
        || resScopeAllowed;
    }

    function authTransportWriteAllowed(data) {
      return hasLegacyAuthSession() || (hasActiveAuthProfile()
        && data.site in ['OTC', 'RES']
        && authProfile().role in ['bht', 'tech', 'supervisor', 'admin']
        && (
          authProfile().role == 'admin'
          || authTransportLocationAllowed(data.site)
        )
        && (
          authProfile().role in ['supervisor', 'admin']
          || data.createdByUserId == authAppUserId()
        ));
    }

    function authTransportDeleteAllowed(data) {
      return hasLegacyAuthSession()
        || authRoleAllowed(['admin'])
        || (
          authRoleAllowed(['bht', 'tech'])
          && data.site in ['OTC', 'RES']
          && authTransportLocationAllowed(data.site)
          && data.createdByUserId == authAppUserId()
          && data.status in ['open', 'arrived']
        );
    }

    function exactIssueLocationAllowed(locationId) {
      return hasLegacyAuthSession() || (hasActiveAuthProfile()
        && (
          authRole() == 'admin'
          || locationId in authIssueLocations()
          || (
            exists(/databases/$(database)/documents/issueAccess/$(authAppUserId()))
            && get(/databases/$(database)/documents/issueAccess/$(authAppUserId())).data.active == true
            && locationId in get(/databases/$(database)/documents/issueAccess/$(authAppUserId())).data.locationIds
          )
        ));
    }

    function eocRoleAndLocationAllowed(roles, locationId) {
      let normalizedLocation = locationScopeAlias(locationId);
      let locations = activeAuthProfileLocations();
      let issueLocations = hasActiveAuthProfile() && authProfile().issueLocationIds is list
        ? authProfile().issueLocationIds
        : [];
      let legacyLocationAllowed = (
        (normalizedLocation == 'OTC' && ('PHP' in locations || 'RTC' in locations))
        || (normalizedLocation == 'RES' && ('PHP' in locations))
      );
      return hasLegacyAuthSession() || (hasActiveAuthProfile()
        && authProfile().role in roles
        && (
          authProfile().role == 'admin'
          || locationId in locations
          || normalizedLocation in locations
          || legacyLocationAllowed
          || locationId in issueLocations
          || (
            exists(/databases/$(database)/documents/issueAccess/$(authAppUserId()))
            && get(/databases/$(database)/documents/issueAccess/$(authAppUserId())).data.active == true
            && locationId in get(/databases/$(database)/documents/issueAccess/$(authAppUserId())).data.locationIds
          )
        ));
    }

    function validUserWriteData(data) {
      return data.keys().hasAll(['name', 'role', 'active'])
        && data.name is string
        && (!('pinHash' in data) || (data.pinHash is string && data.pinHash.size() >= 32))
        && (!('email' in data) || data.email == null || data.email is string)
        && (!('emailDomain' in data) || data.emailDomain == null || data.emailDomain is string)
        && (!('emailType' in data) || data.emailType == null || data.emailType in ['company', 'external'])
        && (!('externalGoogleAllowed' in data) || data.externalGoogleAllowed is bool)
        && (!('issueLocationIds' in data) || data.issueLocationIds is list)
        && validRole(data.role)
        && data.active is bool
        && (!('site' in data) || data.site is string)
        && (!('location' in data) || data.location is string)
        && (!('house' in data) || data.house == null || data.house is string)
        && (!('locationId' in data) || data.locationId == null || data.locationId is string)
        && (!('shiftId' in data) || data.shiftId == null || data.shiftId is string)
        && (!('vanId' in data) || data.vanId == null || data.vanId is string)
        && (!('authorizedLocations' in data) || data.authorizedLocations is list)
        && (!('pin' in data) || data.pin is string)
        && (
          validAdminWriteData(data)
          || validSupervisorWriteData(data)
          || validBhtWriteData(data)
        );
    }

    function roleCanSelfRotatePin(role) {
      return roleIsBht(role) || role == 'supervisor' || role == 'admin';
    }

    function authUidMatchesTargetUser() {
      return request.auth != null
        && resource.data.authUid is string
        && resource.data.authUid.size() > 0
        && request.auth.uid == resource.data.authUid
        && (!('authUid' in request.resource.data) || request.resource.data.authUid == resource.data.authUid);
    }

    function selfPinOnlyMutation() {
      return request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly(['pinHash', 'pinVersion', 'pinUpdatedAt', 'updatedAt', 'version']);
    }

    function validSelfPinRotateData(data) {
      return roleCanSelfRotatePin(data.role)
        && data.active == true
        && data.pinHash is string
        && data.pinHash.size() >= 32
        && (!('pinVersion' in data) || data.pinVersion == 'v2_sha256_6digit');
    }

    function requesterCanSelfRotatePin(data) {
      return authUidMatchesTargetUser()
        && selfPinOnlyMutation()
        && validSelfPinRotateData(data);
    }

    function validAccessGrantWriteData(data) {
      return data.keys().hasAll([
        'userId', 'userName', 'locationId', 'startsAt', 'expiresAt',
        'reason', 'revoked', 'revokedAt', 'revokedReason',
        'createdByUserId', 'createdByName'
      ])
        && data.userId is string
        && data.userName is string
        && data.locationId is string
        && data.startsAt is timestamp
        && data.expiresAt is timestamp
        && data.reason is string
        && data.reason.size() > 0
        && data.revoked is bool
        && (data.revokedAt == null || data.revokedAt is timestamp)
        && (data.revokedReason == null || data.revokedReason is string)
        && data.createdByUserId is string
        && data.createdByName is string
        && (
          data.revoked != true
          || (data.revokedReason is string && data.revokedReason.size() > 0)
        );
    }

    function validVersionField(data) {
      return !('version' in data) || data.version is int;
    }

    function validEocTaskStatus(status) {
      return status in ['pending', 'overdue', 'completed', 'missed', 'ignored'];
    }

    function validIgnoredTaskPayload(data) {
      return data.status != 'ignored'
        || (
          data.keys().hasAny(['ignoredReason'])
          && data.ignoredReason is string
          && data.ignoredReason.size() > 0
        );
    }

    function validTemplateLibraryData(data) {
      return data.keys().hasAll(['name', 'eocType', 'items', 'status'])
        && data.name is string
        && data.name.size() > 0
        && data.eocType in ['house', 'van']
        && data.items is list
        && data.status in ['active', 'archived']
        && (!('itemSchemaVersion' in data) || data.itemSchemaVersion is int)
        && (!('publishedVersion' in data) || data.publishedVersion is int)
        && (!('publishedVersionId' in data) || data.publishedVersionId == null || data.publishedVersionId is string)
        && (!('ownerUserId' in data) || data.ownerUserId == null || data.ownerUserId is string)
        && (!('ownerAuthUid' in data) || data.ownerAuthUid == null || data.ownerAuthUid is string)
        && (!('ownerName' in data) || data.ownerName == null || data.ownerName is string);
    }

    function templateCreateAllowed() {
      return hasLegacyAuthSession()
        || authRoleAllowed(['admin'])
        || (
          authRoleAllowed(['supervisor'])
          && request.auth != null
          && request.resource.data.ownerAuthUid is string
          && request.resource.data.ownerAuthUid == request.auth.uid
        );
    }

    function templateUpdateAllowed() {
      return hasLegacyAuthSession()
        || authRoleAllowed(['admin'])
        || (
          authRoleAllowed(['supervisor'])
          && request.auth != null
          && resource.data.ownerAuthUid is string
          && request.auth.uid == resource.data.ownerAuthUid
          && request.resource.data.ownerAuthUid == resource.data.ownerAuthUid
          && request.resource.data.ownerUserId == resource.data.ownerUserId
        );
    }

    function validTemplateAssignmentData(data) {
      return data.keys().hasAll(['locationId', 'shiftId', 'eocType', 'defaultTemplateId'])
        && data.locationId is string
        && data.shiftId is string
        && validShiftForLocation(data.locationId, data.shiftId)
        && data.eocType in ['house', 'van']
        && data.defaultTemplateId is string
        && data.defaultTemplateId.size() > 0
        && (!('defaultTemplateName' in data) || data.defaultTemplateName == null || data.defaultTemplateName is string)
        && (!('defaultTemplateVersion' in data) || data.defaultTemplateVersion == null || data.defaultTemplateVersion is int)
        && (!('defaultTemplateVersionId' in data) || data.defaultTemplateVersionId == null || data.defaultTemplateVersionId is string);
    }

    function validTemplateVersionData(data) {
      return data.keys().hasAll([
          'templateId', 'templateName', 'eocType', 'items', 'status',
          'versionNumber', 'ownerAuthUid', 'publishedByUserId'
        ])
        && data.templateId is string
        && data.templateId.size() > 0
        && data.templateName is string
        && data.templateName.size() > 0
        && data.eocType in ['house', 'van']
        && data.items is list
        && data.status in ['active', 'archived']
        && data.versionNumber is int
        && data.versionNumber > 0
        && (data.ownerAuthUid == null || data.ownerAuthUid is string)
        && data.publishedByUserId != null
        && data.publishedByUserId is string
        && (!('itemSchemaVersion' in data) || data.itemSchemaVersion is int);
    }

    function templateVersionCreateAllowed() {
      return hasLegacyAuthSession()
        || authRoleAllowed(['admin'])
        || (
          authRoleAllowed(['supervisor'])
          && request.auth != null
          && request.resource.data.ownerAuthUid == request.auth.uid
        );
    }

    function fleetMainLocationFromData(data) {
      return (
        ('mainLocation' in data)
        && data.mainLocation is string
        && data.mainLocation.size() > 0
      )
        ? normalizedMainLocation(data.mainLocation)
        : normalizedShiftMainLocation(data.locationId);
    }

    function fleetLocationAllowed(data) {
      let mainLocation = fleetMainLocationFromData(data);
      return mainLocation != '' && authLocationAllowed(mainLocation);
    }

    function fleetRuntimeLocationAllowed(data) {
      return (
        (
          ('mainLocation' in data)
          && data.mainLocation is string
          && data.mainLocation.size() > 0
          && authLocationAllowed(data.mainLocation)
        )
        || (
          data.vehicleId is string
          && exists(/databases/$(database)/documents/eocVehicles/$(data.vehicleId))
          && fleetLocationAllowed(get(/databases/$(database)/documents/eocVehicles/$(data.vehicleId)).data)
        )
      );
    }

    function validFleetTaskType(taskType) {
      return taskType in ['oil_change', 'insurance_renewal', 'registration_renewal', 'maintenance_milestone'];
    }

    function validFleetTaskStatus(status) {
      return status in ['upcoming', 'overdue', 'resolved'];
    }

    function validFleetTriggerMode(mode) {
      return mode in ['mileage', 'date'];
    }

    function validDebriefLocationId(locationId) {
      return locationId in ['mesquite', 'lone_mountain', 'test_house'];
    }

    function validShiftDebriefBase(data) {
      return data.locationId is string
        && validDebriefLocationId(data.locationId)
        && data.shiftId is string
        && validShiftForLocation(data.locationId, data.shiftId)
        && data.dateKey is string
        && data.mainLocation == 'OTC'
        && validVersionField(data);
    }

    function validShiftDebriefDraftData(data) {
      return validShiftDebriefBase(data)
        && data.draftByUserId is string
        && data.draftByName is string
        && data.status in ['draft', 'submitted']
        && (!('items' in data) || data.items is list)
        && (!('itemCount' in data) || data.itemCount is int);
    }

    function validSubmittedShiftDebriefData(data) {
      return validShiftDebriefBase(data)
        && data.status == 'submitted'
        && data.submittedByUserId is string
        && data.submittedByName is string
        && data.items is list
        && data.extraNotes is list
        && data.confirmation is map
        && data.confirmed is bool;
    }

    match /usersByAuthUid/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if authRoleAllowed(['admin']);

      allow create: if signedIn()
        && request.auth.uid == uid
        && authEmailVerified()
        && request.resource.data.userId is string
        && request.resource.data.email is string
        && request.resource.data.email == authEmail()
        && request.resource.data.emailDomain is string
        && request.resource.data.version == 1
        && (
          (
            request.resource.data.userId == 'admin_owner'
            && request.resource.data.email == 'mark@scottsdaleprovidence.com'
            && exists(/databases/$(database)/documents/users/admin_owner)
            && get(/databases/$(database)/documents/users/admin_owner).data.role == 'admin'
            && get(/databases/$(database)/documents/users/admin_owner).data.active == true
          )
          || (
            exists(/databases/$(database)/documents/userEmailLinks/$(request.resource.data.email))
            && get(/databases/$(database)/documents/userEmailLinks/$(request.resource.data.email)).data.active == true
            && get(/databases/$(database)/documents/userEmailLinks/$(request.resource.data.email)).data.userId == request.resource.data.userId
            && (
              !('linkedAuthUid' in get(/databases/$(database)/documents/userEmailLinks/$(request.resource.data.email)).data)
              || get(/databases/$(database)/documents/userEmailLinks/$(request.resource.data.email)).data.linkedAuthUid == null
              || get(/databases/$(database)/documents/userEmailLinks/$(request.resource.data.email)).data.linkedAuthUid == request.auth.uid
            )
          )
        );

      allow update, delete: if authRoleAllowed(['admin']);
    }

    match /userEmailLinks/{email} {
      allow get: if authRoleAllowed(['admin'])
        || (
          signedIn()
          && authEmailVerified()
          && email == authEmail()
        );
      allow list: if authRoleAllowed(['admin']);

      allow create: if (
          signedIn()
          && authEmailVerified()
          && email == 'mark@scottsdaleprovidence.com'
          && request.resource.data.email == 'mark@scottsdaleprovidence.com'
          && request.resource.data.userId == 'admin_owner'
          && request.resource.data.emailType == 'company'
          && request.resource.data.externalGoogleAllowed == false
        )
        || authRoleAllowed(['admin']);

      allow update: if authRoleAllowed(['admin'])
        || (
          signedIn()
          && authEmailVerified()
          && email == authEmail()
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.email == resource.data.email
          && request.resource.data.active == resource.data.active
          && request.resource.data.linkedAuthUid == request.auth.uid
        );

      allow delete: if false;
    }

    // Users collection
    match /users/{userId} {
      allow get: if authRoleAllowed(['admin'])
        || authAppUserId() == userId
        || (
          signedIn()
          && authEmailVerified()
          && userId == 'admin_owner'
          && authEmail() == 'mark@scottsdaleprovidence.com'
        )
        || (
          authRoleAllowed(['supervisor'])
          && roleIsBht(resource.data.role)
          && authLocationAllowed(userLocationValue(resource.data))
        );
      allow list: if authRoleAllowed(['admin', 'supervisor']);

      allow create: if validUserWriteData(request.resource.data)
        && authRoleAllowed(['admin'])
        && validVersionField(request.resource.data);

      allow update: if validUserWriteData(request.resource.data)
        && (
          authRoleAllowed(['admin'])
          || requesterCanSelfRotatePin(request.resource.data)
          || (
            authRoleAllowed(['supervisor'])
            && roleIsBht(resource.data.role)
            && request.resource.data.role == resource.data.role
            && request.resource.data.email == resource.data.email
            && request.resource.data.active == resource.data.active
            && request.resource.data.issueLocationIds == resource.data.issueLocationIds
            && authLocationAllowed(userLocationValue(resource.data))
          )
        )
        && validVersionField(request.resource.data)
        && createdAtUnchanged();

      allow delete: if authRoleAllowed(['admin']);
    }

    // Clients collection (autocomplete suggestions)
    match /clients/{clientId} {
      allow read, write: if true;
    }

    // Destinations collection (autocomplete suggestions)
    match /destinations/{destinationId} {
      allow read, write: if true;
    }

    // BHT Assignments collection
    match /shiftAssignments/{docId} {
      allow get: if authRoleAllowed(['supervisor', 'admin'])
        || (
          authRoleAllowed(['bht', 'tech'])
          && docId == ('asg_' + authAppUserId())
        )
        || (
          authRoleAndLocationAllowed(['bht', 'tech'], resource.data.locationId)
          && resource.data.bhtUserId == authAppUserId()
        );

      allow list: if authRoleAllowed(['admin'])
        || (
          authRoleAllowed(['supervisor'])
          && authLocationAllowed(resource.data.locationId)
        )
        || (
          authRoleAllowed(['bht', 'tech'])
          && resource.data.locationId in authIssueLocations()
        );

      allow create: if request.resource.data.keys().hasAll([
        'bhtUserId', 'bhtUserName', 'locationId', 'shiftId', 'vanIds',
        'active'
      ])
        && request.resource.data.bhtUserId is string
        && request.resource.data.bhtUserName is string
        && request.resource.data.locationId is string
        && request.resource.data.shiftId is string
        && validShiftForLocation(request.resource.data.locationId, request.resource.data.shiftId)
        && request.resource.data.vanIds is list
        && request.resource.data.active is bool
        && (
          authRoleAllowed(['admin'])
          || authRoleAndLocationAllowed(['supervisor'], request.resource.data.locationId)
        )
        && validVersionField(request.resource.data);

      allow update: if createdAtUnchanged()
        && (
          authRoleAllowed(['admin'])
          || authRoleAndLocationAllowed(['supervisor'], request.resource.data.locationId)
        )
        && (!('shiftId' in request.resource.data)
          || (
            request.resource.data.shiftId is string
            && validShiftForLocation(request.resource.data.locationId, request.resource.data.shiftId)
          ))
        && validVersionField(request.resource.data);
      allow delete: if authRoleAllowed(['admin'])
        || authRoleAndLocationAllowed(['supervisor'], resource.data.locationId);
    }

    // EOC Tasks collection
    match /eocTasks/{docId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasAll([
        'taskType', 'locationId', 'shiftId', 'dueDate', 'status', 'cycleKey',
        'eligibleUserIds', 'templateScope'
      ])
        && request.resource.data.taskType in ['house', 'van']
        && request.resource.data.shiftId is string
        && validShiftForLocation(request.resource.data.locationId, request.resource.data.shiftId)
        && request.resource.data.templateScope is string
        && validTemplateScope(request.resource.data.templateScope)
        && validEocTaskStatus(request.resource.data.status)
        && validIgnoredTaskPayload(request.resource.data)
        && request.resource.data.eligibleUserIds is list
        && eocRoleAndLocationAllowed(['bht', 'tech', 'supervisor', 'admin'], request.resource.data.locationId)
        && validVersionField(request.resource.data);

      allow update: if validEocTaskStatus(request.resource.data.status)
        && validIgnoredTaskPayload(request.resource.data)
        && request.resource.data.shiftId is string
        && validShiftForLocation(request.resource.data.locationId, request.resource.data.shiftId)
        && request.resource.data.templateScope is string
        && validTemplateScope(request.resource.data.templateScope)
        && (!('eligibleUserIds' in request.resource.data) || request.resource.data.eligibleUserIds is list)
        && (!('eligibleUserNames' in request.resource.data) || request.resource.data.eligibleUserNames is list)
        && eocRoleAndLocationAllowed(['bht', 'tech', 'supervisor', 'admin'], request.resource.data.locationId)
        && validVersionField(request.resource.data)
        && createdAtUnchanged();

      allow delete: if authRoleAndLocationAllowed(['supervisor', 'admin'], resource.data.locationId);
    }

    // EOC Assignments (legacy — kept for historical data)
    match /eocAssignments/{docId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasAll([
        'locationId', 'shiftId', 'dueDate', 'assignedTechId', 'eocType', 'status'
      ])
        && request.resource.data.shiftId is string
        && validShiftForLocation(request.resource.data.locationId, request.resource.data.shiftId)
        && authRoleAndLocationAllowed(['supervisor', 'admin'], request.resource.data.locationId);

      allow update: if createdAtUnchanged()
        && (!('shiftId' in request.resource.data)
          || (
            request.resource.data.shiftId is string
            && validShiftForLocation(request.resource.data.locationId, request.resource.data.shiftId)
          ))
        && authRoleAndLocationAllowed(['supervisor', 'admin'], request.resource.data.locationId);
      allow delete: if authRoleAndLocationAllowed(['supervisor', 'admin'], resource.data.locationId);
    }

    // EOC Submissions
    match /eocSubmissions/{docId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasAll([
        'locationId', 'shiftId', 'eocType', 'submittedByUserId', 'submittedByName', 'templateScope'
      ])
        && request.resource.data.shiftId is string
        && validShiftForLocation(request.resource.data.locationId, request.resource.data.shiftId)
        && request.resource.data.templateScope is string
        && validTemplateScope(request.resource.data.templateScope)
        && eocRoleAndLocationAllowed(['bht', 'tech', 'supervisor', 'admin'], request.resource.data.locationId)
        && validVersionField(request.resource.data);

      allow update: if createdAtUnchanged()
        && (!('shiftId' in request.resource.data)
          || (
            request.resource.data.shiftId is string
            && validShiftForLocation(request.resource.data.locationId, request.resource.data.shiftId)
          ))
        && (!('templateScope' in request.resource.data)
          || (
            request.resource.data.templateScope is string
            && validTemplateScope(request.resource.data.templateScope)
          ))
        && authRoleAndLocationAllowed(['supervisor', 'admin'], request.resource.data.locationId)
        && validVersionField(request.resource.data);
      allow delete: if authRoleAndLocationAllowed(['admin'], resource.data.locationId);
    }

    // EOC Submission Drafts (autosave while checklist is in progress)
    match /eocSubmissionDrafts/{docId} {
      allow get: if (
          !exists(/databases/$(database)/documents/eocSubmissionDrafts/$(docId))
          || (
            eocRoleAndLocationAllowed(['bht', 'tech', 'supervisor', 'admin'], resource.data.locationId)
            && resource.data.draftByUserId is string
          )
        );
      allow list: if false;

      allow create: if request.resource.data.keys().hasAll([
        'taskId', 'locationId', 'shiftId', 'eocType', 'draftByUserId', 'templateScope'
      ])
        && request.resource.data.draftByUserId is string
        && request.resource.data.shiftId is string
        && validShiftForLocation(request.resource.data.locationId, request.resource.data.shiftId)
        && request.resource.data.templateScope is string
        && validTemplateScope(request.resource.data.templateScope)
        && eocRoleAndLocationAllowed(['bht', 'tech', 'supervisor', 'admin'], request.resource.data.locationId)
        && validVersionField(request.resource.data);

      allow update: if request.resource.data.draftByUserId == resource.data.draftByUserId
        && (!('shiftId' in request.resource.data)
          || (
            request.resource.data.shiftId is string
            && validShiftForLocation(request.resource.data.locationId, request.resource.data.shiftId)
          ))
        && (!('templateScope' in request.resource.data)
          || (
            request.resource.data.templateScope is string
            && validTemplateScope(request.resource.data.templateScope)
          ))
        && eocRoleAndLocationAllowed(['bht', 'tech', 'supervisor', 'admin'], request.resource.data.locationId)
        && validVersionField(request.resource.data)
        && createdAtUnchanged();

      allow delete: if resource.data.draftByUserId is string
        && eocRoleAndLocationAllowed(['bht', 'tech', 'supervisor', 'admin'], resource.data.locationId);
    }

    // Shift Debrief Drafts (BHT-owned autosave before handoff submit)
    match /shiftDebriefDrafts/{docId} {
      allow get: if authRoleAllowed(['bht', 'tech', 'supervisor', 'admin']);
      allow list: if false;

      allow read: if authRoleAndLocationAllowed(['bht', 'tech', 'supervisor', 'admin'], resource.data.locationId);

      allow create: if validShiftDebriefDraftData(request.resource.data)
        && authRoleAndLocationAllowed(['bht', 'tech'], request.resource.data.locationId);

      allow update: if validShiftDebriefDraftData(request.resource.data)
        && request.resource.data.draftByUserId == resource.data.draftByUserId
        && authRoleAndLocationAllowed(['bht', 'tech'], request.resource.data.locationId)
        && createdAtUnchanged();

      allow delete: if false;
    }

    // Shift Debriefs (submitted handoff records)
    match /shiftDebriefs/{docId} {
      allow get: if authRoleAllowed(['bht', 'tech', 'supervisor', 'admin'])
        && (
          hasLegacyAuthSession()
          ||
          !exists(/databases/$(database)/documents/shiftDebriefs/$(docId))
          || exactIssueLocationAllowed(resource.data.locationId)
          || resource.data.submittedByUserId == authAppUserId()
          || (
            resource.data.receivingUserIds is list
            && authAppUserId() in resource.data.receivingUserIds
          )
        );
      allow list: if authRoleAllowed(['supervisor', 'admin']);

      allow create: if validSubmittedShiftDebriefData(request.resource.data)
        && (hasLegacyAuthSession() || request.resource.data.submittedByUserId == authAppUserId())
        && (
          authRoleAndLocationAllowed(['bht', 'tech'], request.resource.data.locationId)
          || exactIssueLocationAllowed(request.resource.data.locationId)
        );

      allow update: if validSubmittedShiftDebriefData(request.resource.data)
        && (
          authRoleAndLocationAllowed(['bht', 'tech', 'supervisor', 'admin'], request.resource.data.locationId)
          || exactIssueLocationAllowed(request.resource.data.locationId)
          || (
            resource.data.receivingUserIds is list
            && authAppUserId() in resource.data.receivingUserIds
          )
        )
        && request.resource.data.status == resource.data.status
        && request.resource.data.items == resource.data.items
        && request.resource.data.submittedByUserId == resource.data.submittedByUserId
        && request.resource.data.submittedByName == resource.data.submittedByName
        && request.resource.data.locationId == resource.data.locationId
        && request.resource.data.shiftId == resource.data.shiftId
        && request.resource.data.dateKey == resource.data.dateKey
        && request.resource.data.mainLocation == resource.data.mainLocation
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(['extraNotes', 'confirmation', 'confirmed', 'updatedAt', 'version'])
        && request.resource.data.extraNotes is list
        && (
          request.resource.data.extraNotes == resource.data.extraNotes
          || (
            resource.data.confirmed != true
            && request.resource.data.confirmed != true
            && request.resource.data.extraNotes.size() >= resource.data.extraNotes.size()
          )
        )
        && request.resource.data.confirmation is map
        && createdAtUnchanged();

      allow delete: if false;
    }

    // EOC Issues
    match /eocIssues/{docId} {
      allow read: if exactIssueLocationAllowed(resource.data.locationId);

      allow create: if request.resource.data.keys().hasAll([
        'locationId', 'eocType', 'label', 'status', 'reportedByUserId'
      ])
        && request.resource.data.status == 'open'
        && exactIssueLocationAllowed(request.resource.data.locationId)
        && authRoleAllowed(['bht', 'tech', 'supervisor', 'admin'])
        && validVersionField(request.resource.data);

      allow update: if request.resource.data.status in ['open', 'in_progress', 'resolved', 'voided']
        && authRoleAllowed(['supervisor', 'admin'])
        && exactIssueLocationAllowed(request.resource.data.locationId)
        && validVersionField(request.resource.data)
        && (
          !(request.resource.data.status in ['resolved', 'voided'])
          || (
            request.resource.data.closedAt != null
            && (
              (request.resource.data.status == 'resolved'
                && request.resource.data.keys().hasAny(['resolvedNotes'])
                && request.resource.data.resolvedNotes is string
                && request.resource.data.resolvedNotes.size() > 0)
              || (request.resource.data.status == 'voided'
                && request.resource.data.keys().hasAny(['voidReason'])
                && request.resource.data.voidReason is string
                && request.resource.data.voidReason.size() > 0)
            )
          )
        )
        && createdAtUnchanged();
      allow delete: if false;

      match /activity/{activityId} {
        allow read: if exactIssueLocationAllowed(get(/databases/$(database)/documents/eocIssues/$(docId)).data.locationId);
        allow create: if (hasLegacyAuthSession() || signedIn())
          && request.resource.data.issueId == docId
          && exactIssueLocationAllowed(request.resource.data.locationId)
          && request.resource.data.immutable == true
          && (
            !(request.resource.data.eventType in ['problem_returned', 'bht_follow_up'])
            || hasLegacyAuthSession()
            || (
              authRoleAllowed(['bht', 'tech'])
              && request.resource.data.actorUserId == authAppUserId()
            )
          )
          && validVersionField(request.resource.data);
        allow update, delete: if false;
      }
    }

    // Supervisor Alerts
    match /alerts/{docId} {
      allow read: if hasLegacyAuthSession()
        || (
          resource.data.audience == 'bht'
          && resource.data.targetUserId == authAppUserId()
        )
        || (
          resource.data.audience == 'supervisor'
          && authRoleAllowed(['supervisor', 'admin'])
          && (
            (
              resource.data.type in ['eoc_issue', 'eoc_issue_update', 'shift_debrief_submitted', 'shift_debrief_missing', 'shift_debrief_no_receivers', 'shift_debrief_incoming_ack_late']
              && exactIssueLocationAllowed(resource.data.locationId)
            )
            || (
              !(resource.data.type in ['eoc_issue', 'eoc_issue_update', 'shift_debrief_submitted', 'shift_debrief_missing', 'shift_debrief_no_receivers', 'shift_debrief_incoming_ack_late'])
              && authLocationAllowed(resource.data.locationId)
            )
          )
        );

      allow create: if request.resource.data.keys().hasAll([
        'type', 'message', 'read', 'audience'
      ])
        && request.resource.data.read is bool
        && (
          exactIssueLocationAllowed(request.resource.data.locationId)
          || authRoleAndLocationAllowed(['bht', 'tech', 'supervisor', 'admin'], request.resource.data.locationId)
        )
        && validVersionField(request.resource.data);

      allow update: if createdAtUnchanged()
        && (
          (
            authRoleAllowed(['supervisor', 'admin'])
            && authLocationAllowed(request.resource.data.locationId)
          )
          || (
            request.resource.data.targetUserId == authAppUserId()
            && request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly(['read', 'readAt', 'readByUserId', 'readByName', 'updatedAt', 'version'])
          )
        )
        && validVersionField(request.resource.data);
      allow delete: if authRoleAndLocationAllowed(['admin'], resource.data.locationId);
    }

    // Access Grants (temporary backup location access lifecycle)
    match /accessGrants/{docId} {
      allow read: if true;

      allow create: if validAccessGrantWriteData(request.resource.data)
        && authRoleAllowed(['admin'])
        && validVersionField(request.resource.data);

      allow update: if validAccessGrantWriteData(request.resource.data)
        && authRoleAllowed(['admin'])
        && validVersionField(request.resource.data)
        && createdAtUnchanged();

      allow delete: if false;
    }

    match /issueAccess/{appUserId} {
      allow get: if authAppUserId() == appUserId || authRoleAllowed(['admin']);
      allow list: if authRoleAllowed(['admin']);
      allow create, update: if authRoleAllowed(['admin'])
        && request.resource.data.userId == appUserId
        && request.resource.data.locationIds is list
        && request.resource.data.active is bool
        && validVersionField(request.resource.data);
      allow delete: if false;
    }

    match /userHomeState/{appUserId} {
      allow get: if authAppUserId() == appUserId || authRoleAllowed(['admin']);
      allow list: if false;
      allow create, update: if (hasLegacyAuthSession() || authAppUserId() == appUserId)
        && request.resource.data.keys().hasOnly([
          'reviewedDebriefIds',
          'lastReviewedDebriefId',
          'lastReviewedAt',
          'updatedAt',
          'version'
        ])
        && (!('reviewedDebriefIds' in request.resource.data) || request.resource.data.reviewedDebriefIds is list)
        && validVersionField(request.resource.data);
      allow delete: if false;
    }

    // Audit Logs
    match /auditLogs/{docId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasAll([
        'action', 'collectionPath', 'documentId',
        'performedByUserId', 'performedByName', 'reason'
      ])
        && authRoleAllowed(['bht', 'tech', 'supervisor', 'admin'])
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && validVersionField(request.resource.data);

      allow update: if false;
      allow delete: if false;
    }

    // EOC Template Library (named templates used by location+shift defaults)
    match /eocTemplateLibrary/{docId} {
      allow read: if true;

      allow create: if validTemplateLibraryData(request.resource.data)
        && templateCreateAllowed()
        && validVersionField(request.resource.data);

      allow update: if validTemplateLibraryData(request.resource.data)
        && templateUpdateAllowed()
        && validVersionField(request.resource.data)
        && createdAtUnchanged();

      allow delete: if authRoleAllowed(['admin'])
        || (
          resource.data.status in ['open', 'arrived']
          && authRoleAndLocationAllowed(['bht', 'tech', 'supervisor', 'admin'], resource.data.site)
        );
    }

    // EOC Template Assignments (default template per location+shift+type)
    match /eocTemplateAssignments/{docId} {
      allow read: if true;

      allow create: if validTemplateAssignmentData(request.resource.data)
        && authRoleAndLocationAllowed(['supervisor', 'admin'], request.resource.data.locationId)
        && validVersionField(request.resource.data);

      allow update: if validTemplateAssignmentData(request.resource.data)
        && authRoleAndLocationAllowed(['supervisor', 'admin'], request.resource.data.locationId)
        && validVersionField(request.resource.data)
        && createdAtUnchanged();

      allow delete: if authRoleAllowed(['admin']);
    }

    // Legacy EOC Checklist Template
    match /eocChecklistTemplate/{docId} {
      allow read: if true;
      allow write: if authRoleAllowed(['admin']);
    }

    // EOC Template Drafts (Draft -> Diff -> Publish workflow)
    match /eocTemplateDrafts/{docId} {
      allow read: if true;
      allow write: if authRoleAllowed(['admin']);
    }

    // EOC Template Version History
    match /eocTemplateVersions/{docId} {
      allow read: if true;
      allow create: if validTemplateVersionData(request.resource.data)
        && templateVersionCreateAllowed()
        && validVersionField(request.resource.data);
      allow update, delete: if false;
    }

    // EOC Vehicles
    match /eocVehicles/{docId} {
      allow read: if true;
      allow create: if authRoleAllowed(['supervisor', 'admin'])
        && fleetLocationAllowed(request.resource.data)
        && validVersionField(request.resource.data);
      allow update: if authRoleAllowed(['supervisor', 'admin'])
        && fleetLocationAllowed(request.resource.data)
        && validVersionField(request.resource.data)
        && createdAtUnchanged();
      allow delete: if authRoleAllowed(['supervisor', 'admin'])
        && fleetLocationAllowed(resource.data);
    }

    // Property profiles
    match /eocProperties/{docId} {
      allow read: if authRoleAllowed(['supervisor', 'admin'])
        && fleetLocationAllowed(resource.data);
      allow create: if authRoleAllowed(['supervisor', 'admin'])
        && fleetLocationAllowed(request.resource.data)
        && validVersionField(request.resource.data);
      allow update: if authRoleAllowed(['supervisor', 'admin'])
        && fleetLocationAllowed(request.resource.data)
        && validVersionField(request.resource.data)
        && createdAtUnchanged();
      allow delete: if authRoleAllowed(['supervisor', 'admin'])
        && fleetLocationAllowed(resource.data);
    }

    // Fleet maintenance templates
    match /fleetMaintenanceTemplates/{docId} {
      allow read: if true;
      allow create: if authRoleAllowed(['supervisor', 'admin'])
        && fleetLocationAllowed(request.resource.data)
        && validVersionField(request.resource.data);
      allow update: if authRoleAllowed(['supervisor', 'admin'])
        && fleetLocationAllowed(request.resource.data)
        && validVersionField(request.resource.data)
        && createdAtUnchanged();
      allow delete: if authRoleAllowed(['supervisor', 'admin'])
        && fleetLocationAllowed(resource.data);
    }

    // Fleet runtime (strict mileage update path for BHT/tech)
    match /fleetVehicleRuntime/{docId} {
      allow read: if authRoleAllowed(['supervisor', 'admin']);

      allow create: if authRoleAllowed(['bht', 'tech', 'supervisor', 'admin'])
        && request.resource.data.vehicleId is string
        && request.resource.data.lastKnownMileage is int
        && request.resource.data.lastKnownMileage >= 0
        && fleetRuntimeLocationAllowed(request.resource.data)
        && validVersionField(request.resource.data);

      allow update: if authRoleAllowed(['bht', 'tech', 'supervisor', 'admin'])
        && request.resource.data.vehicleId is string
        && request.resource.data.vehicleId == resource.data.vehicleId
        && request.resource.data.lastKnownMileage is int
        && (
          !('lastKnownMileage' in resource.data)
          || request.resource.data.lastKnownMileage >= resource.data.lastKnownMileage
        )
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'vehicleId',
            'mainLocation',
            'lastKnownMileage',
            'lastKnownMileageAt',
            'lastKnownSubmissionId',
            'version',
            'updatedAt'
          ])
        && fleetRuntimeLocationAllowed(request.resource.data)
        && validVersionField(request.resource.data)
        && createdAtUnchanged();

      allow delete: if false;
    }

    // Fleet task queue
    match /fleetTasks/{docId} {
      allow read: if authRoleAllowed(['supervisor', 'admin']);

      allow create: if authRoleAllowed(['supervisor', 'admin'])
        && validFleetTaskType(request.resource.data.taskType)
        && validFleetTaskStatus(request.resource.data.status)
        && validFleetTriggerMode(request.resource.data.triggerMode)
        && fleetLocationAllowed(request.resource.data)
        && validVersionField(request.resource.data);

      allow update: if authRoleAllowed(['supervisor', 'admin'])
        && validFleetTaskType(request.resource.data.taskType)
        && validFleetTaskStatus(request.resource.data.status)
        && validFleetTriggerMode(request.resource.data.triggerMode)
        && fleetLocationAllowed(request.resource.data)
        && validVersionField(request.resource.data)
        && createdAtUnchanged();

      allow delete: if authRoleAllowed(['supervisor', 'admin'])
        && fleetLocationAllowed(resource.data);
    }

    // Vehicle service records
    match /vehicleServiceRecords/{docId} {
      allow read: if authRoleAllowed(['supervisor', 'admin'])
        && fleetLocationAllowed(resource.data);

      allow create: if authRoleAllowed(['supervisor', 'admin'])
        && fleetLocationAllowed(request.resource.data)
        && validVersionField(request.resource.data);

      allow update: if authRoleAllowed(['supervisor', 'admin'])
        && fleetLocationAllowed(request.resource.data)
        && validVersionField(request.resource.data)
        && createdAtUnchanged();

      allow delete: if authRoleAllowed(['admin'])
        && fleetLocationAllowed(resource.data);
    }

    // Compliance collections
    match /complianceEmployees/{employeeId} {
      allow read: if true;
      allow write: if authRoleAllowed(['supervisor', 'admin']);
    }
    match /complianceItems/{itemId} {
      allow read: if true;
      allow create, update: if authRoleAllowed(['supervisor', 'admin'])
        && (
          authLocationAllowed(request.resource.data.employeeSite)
          || authLocationAllowed(request.resource.data.mainLocation)
          || authLocationAllowed(request.resource.data.locationId)
        );
      allow delete: if authRoleAllowed(['supervisor', 'admin'])
        && (
          authLocationAllowed(resource.data.employeeSite)
          || authLocationAllowed(resource.data.mainLocation)
          || authLocationAllowed(resource.data.locationId)
        );
    }
    match /cintasServices/{serviceId} {
      allow read: if authRoleAllowed(['supervisor', 'admin'])
        && (
          authLocationAllowed(resource.data.mainLocation)
          || authLocationAllowed(resource.data.locationId)
        )
        || (
          authRoleAllowed(['admin'])
          && !('mainLocation' in resource.data)
          && !('locationId' in resource.data)
        );
      allow write: if authRoleAllowed(['supervisor', 'admin'])
        && (
          authLocationAllowed(request.resource.data.mainLocation)
          || authLocationAllowed(request.resource.data.locationId)
        );
    }

    // Transports collection
    match /transports/{transportId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasAll([
        'site', 'createdByUserId', 'createdByName', 'status', 'departedAt', 'createdAt'
        ])
        && request.resource.data.status in ['open', 'arrived', 'returned', 'closed']
        && request.resource.data.site in ['OTC', 'RES']
        && authTransportWriteAllowed(request.resource.data)
        && validVersionField(request.resource.data);

      allow update: if request.resource.data.keys().hasAll([
        'site', 'createdByUserId', 'createdByName', 'status', 'departedAt', 'updatedAt'
        ])
        && request.resource.data.status in ['open', 'arrived', 'returned', 'closed']
        && authTransportWriteAllowed(request.resource.data)
        && validVersionField(request.resource.data)
        && request.resource.data.createdByUserId == resource.data.createdByUserId
        && request.resource.data.createdByName == resource.data.createdByName
        && request.resource.data.site == resource.data.site
        && createdAtUnchanged()
        && (
          !(request.resource.data.status in ['returned', 'closed'])
          || (
            request.resource.data.keys().hasAny(['dcPaperworkStatus'])
            && request.resource.data.dcPaperworkStatus in ['collected', 'na', 'other']
            && (
              request.resource.data.dcPaperworkStatus != 'other'
              || (request.resource.data.keys().hasAny(['dcPaperworkOtherNote'])
                  && request.resource.data.dcPaperworkOtherNote is string
                  && request.resource.data.dcPaperworkOtherNote.size() > 0)
            )
          )
        );

      allow delete: if authTransportDeleteAllowed(resource.data);
    }

    // App settings
    match /appSettings/{docId} {
      allow read: if true;
      allow write: if authRoleAllowed(['admin']);
    }

    // Deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

