rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================================
    // PIN-COMPATIBLE AUTH MODEL
    // ============================================================================
    // PIN mode uses the application-selected `users/{id}` profile. Strict mapped
    // Firebase Auth remains available behind `authScopeEnforced` for rollback.
    // ============================================================================

    // Helper: prevent createdAt from being changed after creation
    function createdAtUnchanged() {
      return !('createdAt' in resource.data)
             || request.resource.data.createdAt == resource.data.createdAt;
    }

    function validRole(role) {
      return role in ['bht', 'supervisor', 'admin', 'tech'];
    }

    function roleIsBht(role) {
      return role == 'bht' || role == 'tech';
    }

    function normalizedMainLocation(locationId) {
      return (
        locationId == 'OTC'
        || locationId == 'PHP'
        || locationId == 'RTC'
      )
        ? 'OTC'
        : (
            locationId == 'RES'
              ? 'RES'
              : ''
          );
    }

    function validMainLocation(locationId) {
      return normalizedMainLocation(locationId) != '';
    }

    function validHouseId(houseId) {
      return houseId in ['MESQUITE', 'LONE_MOUNTAIN', 'TEST_HOUSE'];
    }

    function validVanId(vanId) {
      return vanId in ['van_1', 'van_2', 'van_3', 'van_4', 'van_test'];
    }

    function validShiftId(shiftId) {
      return shiftId in [
        'shift_1',
        'shift_2',
        'res_shift_1_day',
        'res_shift_1_night',
        'res_shift_2_day',
        'res_shift_2_night'
      ];
    }

    function validTemplateScope(templateScope) {
      return templateScope in ['otc_shared', 'res_day', 'res_night'];
    }

    function validShiftForMainLocation(mainLocation, shiftId) {
      return (
        (mainLocation == 'OTC' && shiftId in ['shift_1', 'shift_2'])
        || (
          mainLocation == 'RES'
          && shiftId in ['res_shift_1_day', 'res_shift_1_night', 'res_shift_2_day', 'res_shift_2_night']
        )
      );
    }

    function normalizedShiftMainLocation(locationId) {
      return (
        locationId == 'mesquite'
        || locationId == 'MESQUITE'
        || locationId == 'lone_mountain'
        || locationId == 'LONE_MOUNTAIN'
        || locationId == 'test_house'
        || locationId == 'TEST_HOUSE'
        || locationId == 'OTC'
        || locationId == 'PHP'
        || locationId == 'RTC'
      )
        ? 'OTC'
        : (
            locationId == 'res'
            || locationId == 'RES'
              ? 'RES'
              : normalizedMainLocation(locationId)
          );
    }

    function validShiftForLocation(locationId, shiftId) {
      return validShiftId(shiftId)
        && validShiftForMainLocation(normalizedShiftMainLocation(locationId), shiftId);
    }

    function userLocationValue(data) {
      return ('location' in data) ? data.location : (('site' in data) ? data.site : '');
    }

    function validBhtWriteData(data) {
      let mainLocation = normalizedMainLocation(userLocationValue(data));
      return roleIsBht(data.role)
        && (
          (data.deleted == true && data.active == false)
          || (
            validMainLocation(userLocationValue(data))
            && data.vanId is string
            && validVanId(data.vanId)
            && data.shiftId is string
            && validShiftForMainLocation(mainLocation, data.shiftId)
            && data.locationId is string
            && (
              mainLocation == 'OTC'
                ? (
                  data.house is string
                  && validHouseId(data.house)
                  && data.locationId in ['mesquite', 'lone_mountain', 'test_house']
                  && data.vanId in ['van_1', 'van_2', 'van_4', 'van_test']
                )
                : (
                  mainLocation == 'RES'
                  && data.locationId == 'res'
                  && data.vanId == 'van_3'
                  && (
                    !('house' in data)
                    || data.house == null
                    || data.house == ''
                  )
                )
              )
            )
          );
    }

    function validSupervisorWriteData(data) {
      return data.role == 'supervisor'
        && (
          (data.deleted == true && data.active == false)
          || validMainLocation(userLocationValue(data))
        )
        && (
          !('house' in data)
          || data.house == null
          || data.house == ''
        )
        && (
          !('vanId' in data)
          || data.vanId == null
          || data.vanId == ''
        );
    }

    function validAdminWriteData(data) {
      return data.role == 'admin'
        && userLocationValue(data) == 'GLOBAL';
    }

    function signedIn() {
      return request.auth != null;
    }

    function hasAuthScopeClaims() {
      return signedIn()
        && request.auth.token.role is string
        && request.auth.token.locations is list;
    }

    function authScopeEnforced() {
      return exists(/databases/$(database)/documents/appSettings/authPolicy)
        && get(/databases/$(database)/documents/appSettings/authPolicy).data.authScopeEnforced == true;
    }

    function hasLegacyAuthSession() {
      return !authScopeEnforced();
    }

    function authEmail() {
      return signedIn() && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }

    function authEmailVerified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function hasAuthUidMapping() {
      return signedIn()
        && exists(/databases/$(database)/documents/usersByAuthUid/$(request.auth.uid));
    }

    function authAppUserId() {
      return hasAuthUidMapping()
        ? get(/databases/$(database)/documents/usersByAuthUid/$(request.auth.uid)).data.userId
        : '';
    }

    function hasActiveAuthProfile() {
      return hasAuthUidMapping()
        && exists(/databases/$(database)/documents/users/$(authAppUserId()))
        && get(/databases/$(database)/documents/users/$(authAppUserId())).data.active == true
        && (
          !('deleted' in get(/databases/$(database)/documents/users/$(authAppUserId())).data)
          || get(/databases/$(database)/documents/users/$(authAppUserId())).data.deleted != true
        );
    }

    function authProfile() {
      return get(/databases/$(database)/documents/users/$(authAppUserId())).data;
    }

    function authRole() {
      return hasActiveAuthProfile() ? authProfile().role : '';
    }

    function authLocations() {
      return hasActiveAuthProfile() && authProfile().authorizedLocations is list
        ? authProfile().authorizedLocations
        : [];
    }

    function activeAuthProfileLocations() {
      return hasActiveAuthProfile() && authProfile().authorizedLocations is list
        ? authProfile().authorizedLocations
        : [];
    }

    function authIssueLocations() {
      return hasActiveAuthProfile() && authProfile().issueLocationIds is list
        ? authProfile().issueLocationIds
        : [];
    }

    function authRoleAllowed(roles) {
      return hasLegacyAuthSession()
        || (hasActiveAuthProfile() && authProfile().role in roles);
    }

    // Map house location IDs to supervisor site scopes used in auth claims.
    function locationScopeAlias(locationId) {
      return (
        locationId == 'mesquite'
        || locationId == 'MESQUITE'
        || locationId == 'lone_mountain'
        || locationId == 'LONE_MOUNTAIN'
        || locationId == 'test_house'
        || locationId == 'TEST_HOUSE'
        || locationId == 'OTC'
        || locationId == 'PHP'
        || locationId == 'RTC'
      )
        ? 'OTC'
        : (
            locationId == 'res' || locationId == 'RES'
              ? 'RES'
              : locationId
          );
    }

    function authLocationAllowed(locationId) {
      let normalizedLocation = locationScopeAlias(locationId);
      let legacyLocationAllowed = (
        (normalizedLocation == 'OTC' && ('PHP' in authLocations() || 'RTC' in authLocations()))
        || (normalizedLocation == 'RES' && ('PHP' in authLocations()))
      );
      return hasLegacyAuthSession() || (
        hasActiveAuthProfile()
        && (
          authRole() == 'admin'
          || locationId in authLocations()
          || normalizedLocation in authLocations()
          || legacyLocationAllowed
        )
      );
    }

    function authRoleAndLocationAllowed(roles, locationId) {
      let normalizedLocation = locationScopeAlias(locationId);
      let locations = activeAuthProfileLocations();
      let legacyLocationAllowed = (
        (normalizedLocation == 'OTC' && ('PHP' in locations || 'RTC' in locations))
        || (normalizedLocation == 'RES' && ('PHP' in locations))
      );
      return hasLegacyAuthSession() || (hasActiveAuthProfile()
        && authProfile().role in roles
        && (
          authProfile().role == 'admin'
          || locationId in locations
          || normalizedLocation in locations
          || legacyLocationAllowed
        ));
    }

    function authTransportLocationAllowed(locationId) {
      let normalizedLocation = locationScopeAlias(locationId);
      let locations = activeAuthProfileLocations();
      let legacyLocationAllowed = (
        (normalizedLocation == 'OTC' && ('PHP' in locations || 'RTC' in locations))
        || (normalizedLocation == 'RES' && ('PHP' in locations))
      );
      let otcHouseScopeAllowed = normalizedLocation == 'OTC'
        && (
          'MESQUITE' in locations
          || 'mesquite' in locations
          || 'LONE_MOUNTAIN' in locations
          || 'lone_mountain' in locations
          || 'TEST_HOUSE' in locations
          || 'test_house' in locations
        );
      let resScopeAllowed = normalizedLocation == 'RES'
        && 'res' in locations;
      return locationId in locations
        || normalizedLocation in locations
        || legacyLocationAllowed
        || otcHouseScopeAllowed
        || resScopeAllowed;
    }

    function authTransportWriteAllowed(data) {
      return hasLegacyAuthSession() || (hasActiveAuthProfile()
        && data.site in ['OTC', 'RES']
        && authProfile().role in ['bht', 'tech', 'supervisor', 'admin']
        && (
          authProfile().role == 'admin'
          || authTransportLocationAllowed(data.site)
        )
        && (
          authProfile().role in ['supervisor', 'admin']
          || data.createdByUserId == authAppUserId()
        ));
    }

    function authTransportDeleteAllowed(data) {
      return hasLegacyAuthSession()
        || authRoleAllowed(['admin'])
        || (
          authRoleAllowed(['bht', 'tech'])
          && data.site in ['OTC', 'RES']
          && authTransportLocationAllowed(data.site)
          && data.createdByUserId == authAppUserId()
          && data.status in ['open', 'arrived']
        );
    }

    function exactIssueLocationAllowed(locationId) {
      return hasLegacyAuthSession() || (hasActiveAuthProfile()
        && (
          authRole() == 'admin'
          || locationId in authIssueLocations()
          || (
            exists(/databases/$(database)/documents/issueAccess/$(authAppUserId()))
            && get(/databases/$(database)/documents/issueAccess/$(authAppUserId())).data.active == true
            && locationId in get(/databases/$(database)/documents/issueAccess/$(authAppUserId())).data.locationIds
          )
        ));
    }

    function activeEocProfileAllowed(profile, profileId, roles, locationId) {
      let normalizedLocation = locationScopeAlias(locationId);
      let locations = 'authorizedLocations' in profile && profile.authorizedLocations is list
        ? profile.authorizedLocations
        : [];
      let issueLocations = 'issueLocationIds' in profile && profile.issueLocationIds is list
        ? profile.issueLocationIds
        : [];
      let legacyLocationAllowed = (
        (normalizedLocation == 'OTC' && ('PHP' in locations || 'RTC' in locations))
        || (normalizedLocation == 'RES' && ('PHP' in locations))
      );
      return profile.active == true
        && (!('deleted' in profile) || profile.deleted != true)
        && profile.role in roles
        && (
          profile.role == 'admin'
          || locationId in locations
          || normalizedLocation in locations
          || legacyLocationAllowed
          || locationId in issueLocations
          || (
            exists(/databases/$(database)/documents/issueAccess/$(profileId))
            && get(/databases/$(database)/documents/issueAccess/$(profileId)).data.active == true
            && locationId in get(/databases/$(database)/documents/issueAccess/$(profileId)).data.locationIds
          )
        );
    }

    function mappedEocRoleAndLocationAllowed(roles, locationId) {
      let profileId = get(/databases/$(database)/documents/usersByAuthUid/$(request.auth.uid)).data.userId;
      return profileId is string
        && profileId != ''
        && exists(/databases/$(database)/documents/users/$(profileId))
        && activeEocProfileAllowed(
          get(/databases/$(database)/documents/users/$(profileId)).data,
          profileId,
          roles,
          locationId
        );
    }

    function eocRoleAndLocationAllowed(roles, locationId) {
      return hasLegacyAuthSession()
        || (
          signedIn()
          && exists(/databases/$(database)/documents/usersByAuthUid/$(request.auth.uid))
          && mappedEocRoleAndLocationAllowed(roles, locationId)
        );
    }

    function validUserWriteData(data) {
      return data.keys().hasAll(['name', 'role', 'active'])
        && data.name is string
        && (!('pinHash' in data) || (data.pinHash is string && data.pinHash.size() >= 32))
        && (!('email' in data) || data.email == null || data.email is string)
        && (!('emailDomain' in data) || data.emailDomain == null || data.emailDomain is string)
        && (!('emailType' in data) || data.emailType == null || data.emailType in ['company', 'external'])
        && (!('externalGoogleAllowed' in data) || data.externalGoogleAllowed is bool)
        && (!('issueLocationIds' in data) || data.issueLocationIds is list)
        && validRole(data.role)
        && data.active is bool
        && (!('site' in data) || data.site is string)
        && (!('location' in data) || data.location is string)
        && (!('house' in data) || data.house == null || data.house is string)
        && (!('locationId' in data) || data.locationId == null || data.locationId is string)
        && (!('shiftId' in data) || data.shiftId == null || data.shiftId is string)
        && (!('vanId' in data) || data.vanId == null || data.vanId is string)
        && (!('authorizedLocations' in data) || data.authorizedLocations is list)
        && (!('pin' in data) || data.pin is string)
        && (
          validAdminWriteData(data)
          || validSupervisorWriteData(data)
          || validBhtWriteData(data)
        );
    }

    function roleCanSelfRotatePin(role) {
      return roleIsBht(role) || role == 'supervisor' || role == 'admin';
    }

    function authUidMatchesTargetUser() {
      return request.auth != null
        && resource.data.authUid is string
        && resource.data.authUid.size() > 0
        && request.auth.uid == resource.data.authUid
        && (!('authUid' in request.resource.data) || request.resource.data.authUid == resource.data.authUid);
    }

    function selfPinOnlyMutation() {
      return request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly(['pinHash', 'pinVersion', 'pinUpdatedAt', 'updatedAt', 'version']);
    }

    function validSelfPinRotateData(data) {
      return roleCanSelfRotatePin(data.role)
        && data.active == true
        && data.pinHash is string
        && data.pinHash.size() >= 32
        && (!('pinVersion' in data) || data.pinVersion == 'v2_sha256_6digit');
    }

    function requesterCanSelfRotatePin(data) {
      return authUidMatchesTargetUser()
        && selfPinOnlyMutation()
        && validSelfPinRotateData(data);
    }

    function validAccessGrantWriteData(data) {
      return data.keys().hasAll([
        'userId', 'userName', 'locationId', 'startsAt', 'expiresAt',
        'reason', 'revoked', 'revokedAt', 'revokedReason',
        'createdByUserId', 'createdByName'
      ])
        && data.userId is string
        && data.userName is string
        && data.locationId is string
        && data.startsAt is timestamp
        && data.expiresAt is timestamp
        && data.reason is string
        && data.reason.size() > 0
        && data.revoked is bool
        && (data.revokedAt == null || data.revokedAt is timestamp)
        && (data.revokedReason == null || data.revokedReason is string)
        && data.createdByUserId is string
        && data.createdByName is string
        && (
          data.revoked != true
          || (data.revokedReason is string && data.revokedReason.size() > 0)
        );
    }

    function validVersionField(data) {
      return !('version' in data) || data.version is int;
    }

    function validEocTaskStatus(status) {
      return status in ['pending', 'overdue', 'completed', 'missed', 'ignored'];
    }

    function validIgnoredTaskPayload(data) {
      return data.status != 'ignored'
        || (
          data.keys().hasAny(['ignoredReason'])
          && data.ignoredReason is string
          && data.ignoredReason.size() > 0
        );
    }

    function validTemplateLibraryData(data) {
      return data.keys().hasAll(['name', 'eocType', 'items', 'status'])
        && data.name is string
        && data.name.size() > 0
        && data.eocType in ['house', 'van']
        && data.items is list
        && data.status in ['active', 'archived']
        && (!('itemSchemaVersion' in data) || data.itemSchemaVersion is int)
        && (!('publishedVersion' in data) || data.publishedVersion is int)
        && (!('publishedVersionId' in data) || data.publishedVersionId == null || data.publishedVersionId is string)
        && (!('ownerUserId' in data) || data.ownerUserId == null || data.ownerUserId is string)
        && (!('ownerAuthUid' in data) || data.ownerAuthUid == null || data.ownerAuthUid is string)
        && (!('ownerName' in data) || data.ownerName == null || data.ownerName is string);
    }

    function templateCreateAllowed() {
      return hasLegacyAuthSession()
        || authRoleAllowed(['admin'])
        || (
          authRoleAllowed(['supervisor'])
          && request.auth != null
          && request.resource.data.ownerAuthUid is string
          && request.resource.data.ownerAuthUid == request.auth.uid
        );
    }

    function templateUpdateAllowed() {
      return hasLegacyAuthSession()
        || authRoleAllowed(['admin'])
        || (
          authRoleAllowed(['supervisor'])
          && request.auth != null
          && resource.data.ownerAuthUid is string
          && request.auth.uid == resource.data.ownerAuthUid
          && request.resource.data.ownerAuthUid == resource.data.ownerAuthUid
          && request.resource.data.ownerUserId == resource.data.ownerUserId
        );
    }

    function validTemplateAssignmentData(data) {
      return data.keys().hasAll(['locationId', 'shiftId', 'eocType', 'defaultTemplateId'])
        && data.locationId is string
        && data.shiftId is string
        && validShiftForLocation(data.locationId, data.shiftId)
        && data.eocType in ['house', 'van']
        && data.defaultTemplateId is string
        && data.defaultTemplateId.size() > 0
        && (!('defaultTemplateName' in data) || data.defaultTemplateName == null || data.defaultTemplateName is string)
        && (!('defaultTemplateVersion' in data) || data.defaultTemplateVersion == null || data.defaultTemplateVersion is int)
        && (!('defaultTemplateVersionId' in data) || data.defaultTemplateVersionId == null || data.defaultTemplateVersionId is string);
    }

    function validTemplateVersionData(data) {
      return data.keys().hasAll([
          'templateId', 'templateName', 'eocType', 'items', 'status',
          'versionNumber', 'ownerAuthUid', 'publishedByUserId'
        ])
        && data.templateId is string
        && data.templateId.size() > 0
        && data.templateName is string
        && data.templateName.size() > 0
        && data.eocType in ['house', 'van']
        && data.items is list
        && data.status in ['active', 'archived']
        && data.versionNumber is int
        && data.versionNumber > 0
        && (data.ownerAuthUid == null || data.ownerAuthUid is string)
        && data.publishedByUserId != null
        && data.publishedByUserId is string
        && (!('itemSchemaVersion' in data) || data.itemSchemaVersion is int);
    }

    function templateVersionCreateAllowed() {
      return hasLegacyAuthSession()
        || authRoleAllowed(['admin'])
        || (
          authRoleAllowed(['supervisor'])
          && request.auth != null
          && request.resource.data.ownerAuthUid == request.auth.uid
        );
    }

    function fleetMainLocationFromData(data) {
      return (
        ('mainLocation' in data)
        && data.mainLocation is string
        && data.mainLocation.size() > 0
      )
        ? normalizedMainLocation(data.mainLocation)
        : normalizedShiftMainLocation(data.locationId);
    }

    function fleetLocationAllowed(data) {
      let mainLocation = fleetMainLocationFromData(data);
      return mainLocation != '' && authLocationAllowed(mainLocation);
    }

    function fleetRuntimeLocationAllowed(data) {
      return (
        (
          ('mainLocation' in data)
          && data.mainLocation is string
          && data.mainLocation.size() > 0
          && authLocationAllowed(data.mainLocation)
        )
        || (
          data.vehicleId is string
          && exists(/databases/$(database)/documents/eocVehicles/$(data.vehicleId))
          && fleetLocationAllowed(get(/databases/$(database)/documents/eocVehicles/$(data.vehicleId)).data)
        )
      );
    }

    function validFleetTaskType(taskType) {
      return taskType in ['oil_change', 'insurance_renewal', 'registration_renewal', 'maintenance_milestone'];
    }

    function validFleetTaskStatus(status) {
      return status in ['upcoming', 'overdue', 'resolved'];
    }

    function validFleetTriggerMode(mode) {
      return mode in ['mileage', 'date'];
    }

    function validDebriefLocationId(locationId) {
      return locationId in ['mesquite', 'lone_mountain', 'test_house'];
    }

    function validShiftDebriefBase(data) {
      return data.locationId is string
        && validDebriefLocationId(data.locationId)
        && data.shiftId is string
        && validShiftForLocation(data.locationId, data.shiftId)
        && data.dateKey is string
        && data.mainLocation == 'OTC'
        && validVersionField(data);
    }

    function validShiftDebriefDraftData(data) {
      return validShiftDebriefBase(data)
        && data.draftByUserId is string
        && data.draftByName is string
        && data.status in ['draft', 'submitted']
        && (!('items' in data) || data.items is list)
        && (!('itemCount' in data) || data.itemCount is int);
    }

    function validSubmittedShiftDebriefData(data) {
      return validShiftDebriefBase(data)
        && data.status == 'submitted'
        && data.submittedByUserId is string
        && data.submittedByName is string
        && data.receivingUserIds is list
        && !(data.submittedByUserId in data.receivingUserIds)
        && data.items is list
        && data.extraNotes is list
        && data.confirmation is map
        && data.confirmation.acknowledgments is map
        && data.confirmation.acknowledgments.keys().hasOnly(data.receivingUserIds)
        && (
          !('confirmedByUserId' in data.confirmation)
          || data.confirmation.confirmedByUserId == null
          || (
            data.confirmation.confirmedByUserId is string
            && data.confirmation.confirmedByUserId in data.receivingUserIds
          )
        )
        && data.confirmed is bool;
    }

    function shiftDebriefSignoffStarted(data) {
      return data.confirmed == true
        || (
          data.receivingUserIds is list
          && data.confirmation is map
          && ('confirmedByUserId' in data.confirmation)
          && data.confirmation.confirmedByUserId is string
          && data.confirmation.confirmedByUserId in data.receivingUserIds
        );
    }

    function validSubmittedShiftDebriefUpdateData(data) {
      return data.version is int
        && data.receivingUserIds is list
        && !(data.submittedByUserId in data.receivingUserIds)
        && data.extraNotes is list
        && data.confirmation is map
        && data.confirmation.acknowledgments is map
        && data.confirmation.acknowledgments.keys().hasOnly(data.receivingUserIds)
        && (
          !('confirmedByUserId' in data.confirmation)
          || data.confirmation.confirmedByUserId == null
          || (
            data.confirmation.confirmedByUserId is string
            && data.confirmation.confirmedByUserId in data.receivingUserIds
          )
        )
        && data.confirmed is bool;
    }

    match /usersByAuthUid/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if authRoleAllowed(['admin']);

      allow create: if signedIn()
        && request.auth.uid == uid
        && authEmailVerified()
        && request.resource.data.userId is string
        && request.resource.data.email is string
        && request.resource.data.email == authEmail()
        && request.resource.data.emailDomain is string
        && request.resource.data.version == 1
        && (
          (
            request.resource.data.userId == 'admin_owner'
            && request.resource.data.email == 'mark@scottsdaleprovidence.com'
            && exists(/databases/$(database)/documents/users/admin_owner)
            && get(/databases/$(database)/documents/users/admin_owner).data.role == 'admin'
            && get(/databases/$(database)/documents/users/admin_owner).data.active == true
          )
          || (
            exists(/databases/$(database)/documents/userEmailLinks/$(request.resource.data.email))
            && get(/databases/$(database)/documents/userEmailLinks/$(request.resource.data.email)).data.active == true
            && get(/databases/$(database)/documents/userEmailLinks/$(request.resource.data.email)).data.userId == request.resource.data.userId
            && (
              !('linkedAuthUid' in get(/databases/$(database)/documents/userEmailLinks/$(request.resource.data.email)).data)
              || get(/databases/$(database)/documents/userEmailLinks/$(request.resource.data.email)).data.linkedAuthUid == null
              || get(/databases/$(database)/documents/userEmailLinks/$(request.resource.data.email)).data.linkedAuthUid == request.auth.uid
            )
          )
        );

      allow update, delete: if authRoleAllowed(['admin']);
    }

    match /userEmailLinks/{email} {
      allow get: if authRoleAllowed(['admin'])
        || (
          signedIn()
          && authEmailVerified()
          && email == authEmail()
        );
      allow list: if authRoleAllowed(['admin']);

      allow create: if (
          signedIn()
          && authEmailVerified()
          && email == 'mark@scottsdaleprovidence.com'
          && request.resource.data.email == 'mark@scottsdaleprovidence.com'
          && request.resource.data.userId == 'admin_owner'
          && request.resource.data.emailType == 'company'
          && request.resource.data.externalGoogleAllowed == false
        )
        || authRoleAllowed(['admin']);

      allow update: if authRoleAllowed(['admin'])
        || (
          signedIn()
          && authEmailVerified()
          && email == authEmail()
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.email == resource.data.email
          && request.resource.data.active == resource.data.active
          && request.resource.data.linkedAuthUid == request.auth.uid
        );

      allow delete: if false;
    }

    // Users collection
    match /users/{userId} {
      allow get: if (!workflowSecurityEnabled('identity_users') || hasCurrentSecuritySession())
        && (
          workflowRoleAllowed('identity_users', ['admin'])
        || authAppUserId() == userId
        || (
          signedIn()
          && authEmailVerified()
          && userId == 'admin_owner'
          && authEmail() == 'mark@scottsdaleprovidence.com'
        )
        || (
          workflowRoleAllowed('identity_users', ['supervisor'])
          && roleIsBht(resource.data.role)
          && workflowLocationAllowed('identity_users', ['supervisor'], userLocationValue(resource.data))
        )
        );
      allow list: if workflowRoleAllowed('identity_users', ['admin'])
        || (
          workflowRoleAllowed('identity_users', ['supervisor'])
          && roleIsBht(resource.data.role)
          && workflowLocationAllowed('identity_users', ['supervisor'], userLocationValue(resource.data))
        );

      allow create: if !workflowSecurityEnabled('identity_users')
        && validUserWriteData(request.resource.data)
        && (
          authRoleAllowed(['admin'])
          || (
            authRoleAllowed(['supervisor'])
            && roleIsBht(request.resource.data.role)
            && authLocationAllowed(userLocationValue(request.resource.data))
          )
        )
        && validVersionField(request.resource.data);

      allow update: if !workflowSecurityEnabled('identity_users')
        && validUserWriteData(request.resource.data)
        && (
          authRoleAllowed(['admin'])
          || requesterCanSelfRotatePin(request.resource.data)
          || (
            authRoleAllowed(['supervisor'])
            && roleIsBht(resource.data.role)
            && request.resource.data.role == resource.data.role
            && request.resource.data.email == resource.data.email
            && request.resource.data.active == resource.data.active
            && request.resource.data.issueLocationIds == resource.data.issueLocationIds
            && authLocationAllowed(userLocationValue(resource.data))
          )
        )
        && validVersionField(request.resource.data)
        && createdAtUnchanged();

      allow delete: if !workflowSecurityEnabled('identity_users')
        && authRoleAllowed(['admin']);
    }

    // Clients collection (autocomplete suggestions)
    match /clients/{clientId} {
      allow read, write: if workflowRoleAllowed('transports', ['bht', 'tech', 'supervisor', 'admin']);
    }

    // Destinations collection (autocomplete suggestions)
    match /destinations/{destinationId} {
      allow read, write: if workflowRoleAllowed('transports', ['bht', 'tech', 'supervisor', 'admin']);
    }

    // BHT Assignments collection
    match /shiftAssignments/{docId} {
      allow get: if workflowRoleAllowed('identity_users', ['supervisor', 'admin'])
        || (
          workflowRoleAllowed('identity_users', ['bht', 'tech'])
          && docId == ('asg_' + authAppUserId())
        )
        || (
          workflowLocationAllowed('identity_users', ['bht', 'tech'], resource.data.locationId)
          && resource.data.bhtUserId == authAppUserId()
        );

      allow list: if workflowRoleAllowed('identity_users', ['admin'])
        || (
          workflowRoleAllowed('identity_users', ['supervisor'])
          && authLocationAllowed(resource.data.locationId)
        )
        || (
          workflowRoleAllowed('identity_users', ['bht', 'tech'])
          && resource.data.locationId in authIssueLocations()
        );

      allow create: if request.resource.data.keys().hasAll([
        'bhtUserId', 'bhtUserName', 'locationId', 'shiftId', 'vanIds',
        'active'
      ])
        && request.resource.data.bhtUserId is string
        && request.resource.data.bhtUserName is string
        && request.resource.data.locationId is string
        && request.resource.data.shiftId is string
        && validShiftForLocation(request.resource.data.locationId, request.resource.data.shiftId)
        && request.resource.data.vanIds is list
        && request.resource.data.active is bool
        && (
          workflowRoleAllowed('identity_users', ['admin'])
          || workflowLocationAllowed('identity_users', ['supervisor'], request.resource.data.locationId)
        )
        && validVersionField(request.resource.data);

      allow update: if createdAtUnchanged()
        && (
          workflowRoleAllowed('identity_users', ['admin'])
          || workflowLocationAllowed('identity_users', ['supervisor'], request.resource.data.locationId)
        )
        && (!('shiftId' in request.resource.data)
          || (
            request.resource.data.shiftId is string
            && validShiftForLocation(request.resource.data.locationId, request.resource.data.shiftId)
          ))
        && validVersionField(request.resource.data);
      allow delete: if workflowRoleAllowed('identity_users', ['admin'])
        || workflowLocationAllowed('identity_users', ['supervisor'], resource.data.locationId);
    }

    // EOC Tasks collection
    match /eocTasks/{docId} {
      // The strict EOC completion path is implemented as a server transaction.
      // Keep this compatibility read unchanged until that client path is cut
      // over; adding a second rule branch exceeds Firestore's hard expression
      // budget for the existing atomic completion transaction.
      allow read: if true;

      allow create: if request.resource.data.keys().hasAll([
        'taskType', 'locationId', 'shiftId', 'dueDate', 'status', 'cycleKey',
        'eligibleUserIds', 'templateScope'
      ])
        && request.resource.data.taskType in ['house', 'van']
        && request.resource.data.shiftId is string
        && validShiftForLocation(request.resource.data.locationId, request.resource.data.shiftId)
        && request.resource.data.templateScope is string
        && validTemplateScope(request.resource.data.templateScope)
        && validEocTaskStatus(request.resource.data.status)
        && validIgnoredTaskPayload(request.resource.data)
        && request.resource.data.eligibleUserIds is list
        && eocRoleAndLocationAllowed(['bht', 'tech', 'supervisor', 'admin'], request.resource.data.locationId)
        && validVersionField(request.resource.data);

      allow update: if (!workflowSecurityEnabled('eoc') || request.resource.data.status != 'completed')
        && validEocTaskStatus(request.resource.data.status)
        && validIgnoredTaskPayload(request.resource.data)
        && request.resource.data.shiftId is string
        && validShiftForLocation(request.resource.data.locationId, request.resource.data.shiftId)
        && request.resource.data.templateScope is string
        && validTemplateScope(request.resource.data.templateScope)
        && (!('eligibleUserIds' in request.resource.data) || request.resource.data.eligibleUserIds is list)
        && (!('eligibleUserNames' in request.resource.data) || request.resource.data.eligibleUserNames is list)
        && eocRoleAndLocationAllowed(['bht', 'tech', 'supervisor', 'admin'], request.resource.data.locationId)
        && validVersionField(request.resource.data)
        && createdAtUnchanged();

      allow delete: if authRoleAndLocationAllowed(['supervisor', 'admin'], resource.data.locationId);

      match /missedNotes/{noteId} {
        allow read: if true;
        allow create: if request.resource.data.taskId == docId
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.immutable == true
          && authRoleAndLocationAllowed(['supervisor', 'admin'], request.resource.data.locationId)
          && validVersionField(request.resource.data);
        allow update, delete: if false;
      }
    }

    // EOC Assignments (legacy — kept for historical data)
    match /eocAssignments/{docId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasAll([
        'locationId', 'shiftId', 'dueDate', 'assignedTechId', 'eocType', 'status'
      ])
        && request.resource.data.shiftId is string
        && validShiftForLocation(request.resource.data.locationId, request.resource.data.shiftId)
        && authRoleAndLocationAllowed(['supervisor', 'admin'], request.resource.data.locationId);

      allow update: if createdAtUnchanged()
        && (!('shiftId' in request.resource.data)
          || (
            request.resource.data.shiftId is string
            && validShiftForLocation(request.resource.data.locationId, request.resource.data.shiftId)
          ))
        && authRoleAndLocationAllowed(['supervisor', 'admin'], request.resource.data.locationId);
      allow delete: if authRoleAndLocationAllowed(['supervisor', 'admin'], resource.data.locationId);
    }

    // EOC Submissions
    match /eocSubmissions/{docId} {
      allow read: if true;

      allow create: if !workflowSecurityEnabled('eoc')
        && request.resource.data.keys().hasAll([
        'locationId', 'shiftId', 'eocType', 'submittedByUserId', 'submittedByName', 'templateScope'
      ])
        && request.resource.data.shiftId is string
        && validShiftForLocation(request.resource.data.locationId, request.resource.data.shiftId)
        && request.resource.data.templateScope is string
        && validTemplateScope(request.resource.data.templateScope)
        && eocRoleAndLocationAllowed(['bht', 'tech', 'supervisor', 'admin'], request.resource.data.locationId)
        && validVersionField(request.resource.data);

      allow update: if createdAtUnchanged()
        && (!('shiftId' in request.resource.data)
          || (
            request.resource.data.shiftId is string
            && validShiftForLocation(request.resource.data.locationId, request.resource.data.shiftId)
          ))
        && (!('templateScope' in request.resource.data)
          || (
            request.resource.data.templateScope is string
            && validTemplateScope(request.resource.data.templateScope)
          ))
        && authRoleAndLocationAllowed(['supervisor', 'admin'], request.resource.data.locationId)
        && validVersionField(request.resource.data);
      allow delete: if authRoleAndLocationAllowed(['admin'], resource.data.locationId);

      match /attachments/{attachmentId} {
        allow read: if workflowExactIssueLocationAllowed('templates_photos',
          get(/databases/$(database)/documents/eocSubmissions/$(docId)).data.locationId
        );
        allow create: if exists(/databases/$(database)/documents/eocSubmissions/$(docId))
          && request.resource.data.attachmentId == attachmentId
          && request.resource.data.submissionId == docId
          && request.resource.data.locationId == get(/databases/$(database)/documents/eocSubmissions/$(docId)).data.locationId
          && request.resource.data.itemId is string
          && request.resource.data.kind == 'response'
          && request.resource.data.mimeType == 'image/jpeg'
          && request.resource.data.sizeBytes is int
          && request.resource.data.sizeBytes > 0
          && request.resource.data.sizeBytes <= 2 * 1024 * 1024
          && request.resource.data.state in ['waiting', 'uploading', 'uploaded', 'failed']
          && workflowExactIssueLocationAllowed('templates_photos', request.resource.data.locationId)
          && workflowRoleAllowed('templates_photos', ['bht', 'tech', 'supervisor', 'admin'])
          && validVersionField(request.resource.data);
        allow update: if request.resource.data.attachmentId == resource.data.attachmentId
          && request.resource.data.submissionId == resource.data.submissionId
          && request.resource.data.locationId == resource.data.locationId
          && request.resource.data.itemId == resource.data.itemId
          && request.resource.data.storagePath == resource.data.storagePath
          && request.resource.data.mimeType == 'image/jpeg'
          && request.resource.data.state in ['waiting', 'uploading', 'uploaded', 'failed']
          && workflowExactIssueLocationAllowed('templates_photos', resource.data.locationId)
          && workflowRoleAllowed('templates_photos', ['bht', 'tech', 'supervisor', 'admin'])
          && validVersionField(request.resource.data)
          && createdAtUnchanged();
        allow delete: if false;
      }
    }

    // EOC Submission Drafts (autosave while checklist is in progress)
    match /eocSubmissionDrafts/{docId} {
      allow get: if (
          !exists(/databases/$(database)/documents/eocSubmissionDrafts/$(docId))
          || (
            eocRoleAndLocationAllowed(['bht', 'tech', 'supervisor', 'admin'], resource.data.locationId)
            && resource.data.draftByUserId is string
          )
        );
      allow list: if false;

      allow create: if request.resource.data.keys().hasAll([
        'taskId', 'locationId', 'shiftId', 'eocType', 'draftByUserId', 'templateScope'
      ])
        && request.resource.data.draftByUserId is string
        && request.resource.data.shiftId is string
        && validShiftForLocation(request.resource.data.locationId, request.resource.data.shiftId)
        && request.resource.data.templateScope is string
        && validTemplateScope(request.resource.data.templateScope)
        && eocRoleAndLocationAllowed(['bht', 'tech', 'supervisor', 'admin'], request.resource.data.locationId)
        && validVersionField(request.resource.data);

      allow update: if request.resource.data.draftByUserId == resource.data.draftByUserId
        && (!('shiftId' in request.resource.data)
          || (
            request.resource.data.shiftId is string
            && validShiftForLocation(request.resource.data.locationId, request.resource.data.shiftId)
          ))
        && (!('templateScope' in request.resource.data)
          || (
            request.resource.data.templateScope is string
            && validTemplateScope(request.resource.data.templateScope)
          ))
        && eocRoleAndLocationAllowed(['bht', 'tech', 'supervisor', 'admin'], request.resource.data.locationId)
        && validVersionField(request.resource.data)
        && createdAtUnchanged();

      allow delete: if resource.data.draftByUserId is string
        && eocRoleAndLocationAllowed(['bht', 'tech', 'supervisor', 'admin'], resource.data.locationId);
    }

    // Shift Debrief Drafts (BHT-owned autosave before handoff submit)
    match /shiftDebriefDrafts/{docId} {
      allow get: if workflowRoleAllowed('debriefs_alerts', ['bht', 'tech', 'supervisor', 'admin']);
      allow list: if false;

      allow read: if workflowLocationAllowed('debriefs_alerts', ['bht', 'tech', 'supervisor', 'admin'], resource.data.locationId);

      allow create: if validShiftDebriefDraftData(request.resource.data)
        && workflowLocationAllowed('debriefs_alerts', ['bht', 'tech'], request.resource.data.locationId);

      allow update: if validShiftDebriefDraftData(request.resource.data)
        && request.resource.data.draftByUserId == resource.data.draftByUserId
        && workflowLocationAllowed('debriefs_alerts', ['bht', 'tech'], request.resource.data.locationId)
        && createdAtUnchanged();

      allow delete: if false;
    }

    // Shift Debriefs (submitted handoff records)
    match /shiftDebriefs/{docId} {
      allow get: if workflowRoleAllowed('debriefs_alerts', ['bht', 'tech', 'supervisor', 'admin'])
        && (
          (!workflowSecurityEnabled('debriefs_alerts') && hasLegacyAuthSession())
          ||
          !exists(/databases/$(database)/documents/shiftDebriefs/$(docId))
          || workflowExactIssueLocationAllowed('debriefs_alerts', resource.data.locationId)
          || resource.data.submittedByUserId == authAppUserId()
          || (
            resource.data.receivingUserIds is list
            && authAppUserId() in resource.data.receivingUserIds
          )
        );
      allow list: if workflowRoleAllowed('debriefs_alerts', ['supervisor', 'admin']);

      allow create: if validSubmittedShiftDebriefData(request.resource.data)
        && ((!workflowSecurityEnabled('debriefs_alerts') && hasLegacyAuthSession()) || request.resource.data.submittedByUserId == authAppUserId())
        && (
          workflowLocationAllowed('debriefs_alerts', ['bht', 'tech'], request.resource.data.locationId)
          || workflowExactIssueLocationAllowed('debriefs_alerts', request.resource.data.locationId)
        );

      allow update: if workflowSessionReady('debriefs_alerts')
        && validSubmittedShiftDebriefUpdateData(request.resource.data)
        && request.resource.data.status == resource.data.status
        && request.resource.data.items == resource.data.items
        && request.resource.data.submittedByUserId == resource.data.submittedByUserId
        && request.resource.data.submittedByName == resource.data.submittedByName
        && request.resource.data.locationId == resource.data.locationId
        && request.resource.data.shiftId == resource.data.shiftId
        && request.resource.data.dateKey == resource.data.dateKey
        && request.resource.data.mainLocation == resource.data.mainLocation
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasAny(['extraNotes'])
          ? (
            request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly(['extraNotes', 'updatedAt', 'version'])
            && request.resource.data.confirmation == resource.data.confirmation
            && request.resource.data.confirmed == resource.data.confirmed
            && request.resource.data.receivingUserIds == resource.data.receivingUserIds
            && (
              (!workflowSecurityEnabled('debriefs_alerts') && hasLegacyAuthSession())
              || authAppUserId() == resource.data.submittedByUserId
              || workflowRoleAllowed('debriefs_alerts', ['supervisor', 'admin'])
            )
            && (
              (!('receivingUserNames' in resource.data) && !('receivingUserNames' in request.resource.data))
              || request.resource.data.receivingUserNames == resource.data.receivingUserNames
            )
            && !shiftDebriefSignoffStarted(resource.data)
            && !shiftDebriefSignoffStarted(request.resource.data)
            && request.resource.data.extraNotes.size() >= resource.data.extraNotes.size()
          )
          : (
            request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'receivingUserIds', 'receivingUserNames',
              'reassignedAt', 'reassignedByUserId', 'reassignedByName', 'reassignmentReason'
            ])
            ? (
              request.resource.data
                .diff(resource.data)
                .affectedKeys()
                .hasOnly([
                  'receivingUserIds', 'receivingUserNames',
                  'confirmation', 'confirmed',
                  'reassignedAt', 'reassignedByUserId', 'reassignedByName',
                  'reassignmentReason', 'updatedAt', 'version'
                ])
              && workflowLocationAllowed('debriefs_alerts', ['supervisor', 'admin'], resource.data.locationId)
              && (
                (!workflowSecurityEnabled('debriefs_alerts') && hasLegacyAuthSession())
                || request.resource.data.reassignedByUserId == authAppUserId()
              )
              && !shiftDebriefSignoffStarted(resource.data)
              && request.resource.data.receivingUserIds.size() > 0
              && request.resource.data.confirmation.acknowledgments.size() == 0
              && request.resource.data.confirmed == false
              && request.resource.data.extraNotes == resource.data.extraNotes
            )
            : (
              request.resource.data
                .diff(resource.data)
                .affectedKeys()
                .hasOnly(['confirmation', 'confirmed', 'updatedAt', 'version'])
              && request.resource.data.extraNotes == resource.data.extraNotes
              && request.resource.data.receivingUserIds == resource.data.receivingUserIds
              && (
                (!('receivingUserNames' in resource.data) && !('receivingUserNames' in request.resource.data))
                || request.resource.data.receivingUserNames == resource.data.receivingUserNames
              )
              && (
                (!workflowSecurityEnabled('debriefs_alerts') && hasLegacyAuthSession())
                || (
                  authAppUserId() != resource.data.submittedByUserId
                  && authAppUserId() in resource.data.receivingUserIds
                  && request.resource.data.confirmation.acknowledgments
                    .diff(resource.data.confirmation.acknowledgments)
                    .affectedKeys()
                    .hasOnly([authAppUserId()])
                )
              )
            )
          )
        )
        && createdAtUnchanged();

      allow delete: if false;
    }

    // EOC Issues
    match /eocIssues/{docId} {
      allow read: if workflowSecurityEnabled('issues_feedback_audit')
        ? (
          hasCurrentSecuritySession()
          && (
            workflowTokenRole() == 'admin'
            || (
              ('locationId' in resource.data)
              && workflowTokenLocationAllowed(resource.data.locationId)
            )
          )
        )
        : (
          ('locationId' in resource.data)
          && exactIssueLocationAllowed(resource.data.locationId)
        );

      allow create: if !workflowSecurityEnabled('issues_feedback_audit')
        && request.resource.data.keys().hasAll([
        'locationId', 'eocType', 'label', 'status', 'reportedByUserId'
      ])
        && request.resource.data.status == 'open'
        && workflowExactIssueLocationAllowed('issues_feedback_audit', request.resource.data.locationId)
        && workflowRoleAllowed('issues_feedback_audit', ['bht', 'tech', 'supervisor', 'admin'])
        && validVersionField(request.resource.data);

      allow update: if !workflowSecurityEnabled('issues_feedback_audit') && (
          (
            validBhtResolutionTransition(resource.data, request.resource.data)
            && (hasLegacyAuthSession() || strictBhtIssueActor(request.resource.data))
            && createdAtUnchanged()
          )
          || (
            request.resource.data.status in ['open', 'in_progress', 'pending_supervisor_review', 'resolved', 'voided']
            && authRoleAndLocationAllowed(['supervisor', 'admin'], request.resource.data.locationId)
            && request.resource.data.locationId == resource.data.locationId
            && validVersionField(request.resource.data)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'source', 'sourceTrackingId', 'trackingId', 'recurrenceEligible'
            ])
            && (
              !(
                (('parentIssueId' in resource.data) && resource.data.parentIssueId != null && request.resource.data.parentIssueId == null)
                || (('linkedTrackingId' in resource.data) && resource.data.linkedTrackingId != null && request.resource.data.linkedTrackingId == null)
              )
              || authRoleAllowed(['admin'])
            )
            && (
              !(request.resource.data.status in ['resolved', 'voided'])
              || (
                request.resource.data.closedAt != null
                && (
                  (request.resource.data.status == 'resolved'
                    && request.resource.data.keys().hasAny(['resolvedNotes'])
                    && request.resource.data.resolvedNotes is string
                    && request.resource.data.resolvedNotes.size() > 0)
                  || (request.resource.data.status == 'voided'
                    && request.resource.data.keys().hasAny(['voidReason'])
                    && request.resource.data.voidReason is string
                    && request.resource.data.voidReason.size() > 0)
                )
              )
            )
            && createdAtUnchanged()
          )
        );
      allow delete: if false;

      match /activity/{activityId} {
        allow read: if workflowExactIssueLocationAllowed('issues_feedback_audit', get(/databases/$(database)/documents/eocIssues/$(docId)).data.locationId);
        allow create: if !workflowSecurityEnabled('issues_feedback_audit')
          && (hasLegacyAuthSession() || signedIn())
          && request.resource.data.issueId == docId
          && exactIssueLocationAllowed(request.resource.data.locationId)
          && request.resource.data.immutable == true
          && (
            hasLegacyAuthSession()
            || request.resource.data.actorUserId == authAppUserId()
            || authRoleAllowed(['supervisor', 'admin'])
          )
          && (
            !('relationshipAudit' in request.resource.data)
            || request.resource.data.relationshipAudit != true
            || hasLegacyAuthSession()
            || authRoleAllowed(['supervisor', 'admin'])
          )
          && (
            request.resource.data.eventType != 'relationship_unlinked'
            || hasLegacyAuthSession()
            || authRoleAllowed(['admin'])
          )
          && validVersionField(request.resource.data);
        allow update, delete: if false;
      }

      match /attachments/{attachmentId} {
        allow read: if workflowExactIssueLocationAllowed('issues_feedback_audit', get(/databases/$(database)/documents/eocIssues/$(docId)).data.locationId);
        allow create: if workflowSessionReady('issues_feedback_audit') && (hasLegacyAuthSession() || signedIn())
          && request.resource.data.attachmentId == attachmentId
          && request.resource.data.issueId == docId
          && request.resource.data.locationId == get(/databases/$(database)/documents/eocIssues/$(docId)).data.locationId
          && request.resource.data.kind in ['report', 'resolution']
          && request.resource.data.mimeType == 'image/jpeg'
          && request.resource.data.sizeBytes is int
          && request.resource.data.sizeBytes > 0
          && request.resource.data.sizeBytes <= 2 * 1024 * 1024
          && request.resource.data.state in ['waiting', 'uploading', 'uploaded', 'failed']
          && workflowExactIssueLocationAllowed('issues_feedback_audit', request.resource.data.locationId)
          && validVersionField(request.resource.data);
        allow update: if workflowExactIssueLocationAllowed('issues_feedback_audit', resource.data.locationId)
          && request.resource.data.attachmentId == resource.data.attachmentId
          && request.resource.data.issueId == resource.data.issueId
          && request.resource.data.locationId == resource.data.locationId
          && request.resource.data.storagePath == resource.data.storagePath
          && request.resource.data.mimeType == 'image/jpeg'
          && request.resource.data.state in ['waiting', 'uploading', 'uploaded', 'failed']
          && (
            (!workflowSecurityEnabled('issues_feedback_audit') && hasLegacyAuthSession())
            || workflowRoleAllowed('issues_feedback_audit', ['supervisor', 'admin'])
            || (
              workflowRoleAllowed('issues_feedback_audit', ['bht', 'tech'])
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'state', 'uploadedAt', 'lastError', 'updatedAt', 'version'
              ])
            )
          )
          && validVersionField(request.resource.data)
          && createdAtUnchanged();
        allow delete: if false;
      }

      match /attachmentHistory/{historyId} {
        allow read: if workflowExactIssueLocationAllowed('issues_feedback_audit', get(/databases/$(database)/documents/eocIssues/$(docId)).data.locationId);
        allow create: if workflowSessionReady('issues_feedback_audit') && (hasLegacyAuthSession() || signedIn())
          && request.resource.data.issueId == docId
          && request.resource.data.immutable == true
          && validVersionField(request.resource.data);
        allow update, delete: if false;
      }
    }

    function validBhtResolutionTransition(before, after) {
      return before.status in ['open', 'in_progress']
        && after.status == 'pending_supervisor_review'
        && after.locationId == before.locationId
        && after.version == before.version + 1
        && after.latestActivity.eventType == 'resolution_submitted'
        && after.latestActivity.actorUserId == after.resolutionSubmittedByUserId
        && after.resolutionSubmittedNotes is string
        && after.resolutionSubmittedNotes.size() > 0
        && after.diff(before).affectedKeys().hasOnly([
          'status', 'version', 'latestActivity',
          'resolutionSubmittedNotes', 'resolutionSubmittedAt',
          'resolutionSubmittedByUserId', 'resolutionSubmittedByName', 'updatedAt'
        ]);
    }

    function strictBhtIssueActor(data) {
      let userId = authAppUserId();
      let profile = get(/databases/$(database)/documents/users/$(userId)).data;
      return signedIn()
        && userId != ''
        && profile.active == true
        && profile.role in ['bht', 'tech']
        && profile.issueLocationIds is list
        && data.locationId in profile.issueLocationIds
        && data.resolutionSubmittedByUserId == userId;
    }

    // App feedback is intentionally separate from operational EOC issues.
    match /appFeedback/{docId} {
      allow read: if (!workflowSecurityEnabled('issues_feedback_audit') && hasLegacyAuthSession())
        || workflowRoleAllowed('issues_feedback_audit', ['admin'])
        || (
          workflowRoleAllowed('issues_feedback_audit', ['bht', 'tech'])
          && resource.data.submittedByUserId == authAppUserId()
        );

      allow create: if ((!workflowSecurityEnabled('issues_feedback_audit') && hasLegacyAuthSession()) || workflowRoleAllowed('issues_feedback_audit', ['bht', 'tech']))
        && ((!workflowSecurityEnabled('issues_feedback_audit') && hasLegacyAuthSession()) || request.resource.data.submittedByUserId == authAppUserId())
        && request.resource.data.feedbackType == 'app_feedback'
        && request.resource.data.originalText is string
        && request.resource.data.originalText.size() > 0
        && request.resource.data.status == 'new'
        && validVersionField(request.resource.data);

      allow update: if (
          workflowRoleAllowed('issues_feedback_audit', ['admin'])
          && request.resource.data.originalText == resource.data.originalText
          && request.resource.data.submittedByUserId == resource.data.submittedByUserId
          && request.resource.data.feedbackType == resource.data.feedbackType
          && request.resource.data.status in ['new', 'reviewing', 'planned', 'completed', 'duplicate', 'not_actionable']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'adminNote', 'reviewedByUserId', 'reviewedByName',
            'reviewedAt', 'updatedAt', 'version'
          ])
          && validVersionField(request.resource.data)
          && createdAtUnchanged()
        )
        || (
          ((!workflowSecurityEnabled('issues_feedback_audit') && hasLegacyAuthSession()) || workflowRoleAllowed('issues_feedback_audit', ['bht', 'tech']))
          && ((!workflowSecurityEnabled('issues_feedback_audit') && hasLegacyAuthSession()) || resource.data.submittedByUserId == authAppUserId())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['createdAt', 'updatedAt'])
          && request.resource.data.originalText == resource.data.originalText
          && request.resource.data.status == 'new'
          && request.resource.data.version == resource.data.version
        );

      allow delete: if false;
    }

    // Supervisor Alerts
    match /alerts/{docId} {
      allow read: if workflowSessionReady('debriefs_alerts') && (
        (!workflowSecurityEnabled('debriefs_alerts') && hasLegacyAuthSession())
          || (
            resource.data.audience == 'bht'
            && resource.data.targetUserId == authAppUserId()
          )
          || (
            resource.data.audience == 'supervisor'
            && workflowRoleAllowed('debriefs_alerts', ['supervisor', 'admin'])
            && (
              (
                resource.data.type in ['eoc_issue', 'eoc_issue_update', 'shift_debrief_submitted', 'shift_debrief_missing', 'shift_debrief_no_receivers', 'shift_debrief_incoming_ack_late']
                && workflowExactIssueLocationAllowed('debriefs_alerts', resource.data.locationId)
              )
              || (
                !(resource.data.type in ['eoc_issue', 'eoc_issue_update', 'shift_debrief_submitted', 'shift_debrief_missing', 'shift_debrief_no_receivers', 'shift_debrief_incoming_ack_late'])
                && workflowLocationAllowed('debriefs_alerts', ['supervisor', 'admin'], resource.data.locationId)
              )
            )
          )
      );

      allow create: if workflowSessionReady('debriefs_alerts') && request.resource.data.keys().hasAll([
        'type', 'message', 'read', 'audience'
      ])
        && request.resource.data.read is bool
        && (
          workflowExactIssueLocationAllowed('debriefs_alerts', request.resource.data.locationId)
          || workflowLocationAllowed('debriefs_alerts', ['bht', 'tech', 'supervisor', 'admin'], request.resource.data.locationId)
        )
        && validVersionField(request.resource.data);

      allow update: if createdAtUnchanged()
        && (
          (
            workflowRoleAllowed('debriefs_alerts', ['supervisor', 'admin'])
            && workflowLocationAllowed('debriefs_alerts', ['supervisor', 'admin'], request.resource.data.locationId)
          )
          || (
            request.resource.data.targetUserId == authAppUserId()
            && request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly(['read', 'readAt', 'readByUserId', 'readByName', 'updatedAt', 'version'])
          )
        )
        && validVersionField(request.resource.data);
      allow delete: if workflowLocationAllowed('debriefs_alerts', ['admin'], resource.data.locationId);
    }

    // Access Grants (temporary backup location access lifecycle)
    match /accessGrants/{docId} {
      allow read: if !workflowSecurityEnabled('identity_users')
        || workflowRoleAllowed('identity_users', ['supervisor', 'admin']);

      allow create: if !workflowSecurityEnabled('identity_users')
        && validAccessGrantWriteData(request.resource.data)
        && workflowRoleAllowed('identity_users', ['admin'])
        && validVersionField(request.resource.data);

      allow update: if !workflowSecurityEnabled('identity_users')
        && validAccessGrantWriteData(request.resource.data)
        && workflowRoleAllowed('identity_users', ['admin'])
        && validVersionField(request.resource.data)
        && createdAtUnchanged();

      allow delete: if false;
    }

    match /issueAccess/{appUserId} {
      allow get: if workflowSessionReady('identity_users') && (authAppUserId() == appUserId || authRoleAllowed(['admin']));
      allow list: if workflowRoleAllowed('identity_users', ['admin']);
      allow create, update: if !workflowSecurityEnabled('identity_users')
        && workflowRoleAllowed('identity_users', ['admin'])
        && request.resource.data.userId == appUserId
        && request.resource.data.locationIds is list
        && request.resource.data.active is bool
        && validVersionField(request.resource.data);
      allow delete: if false;
    }

    match /userHomeState/{appUserId} {
      allow get: if workflowSessionReady('debriefs_alerts') && (authAppUserId() == appUserId || authRoleAllowed(['admin']));
      allow list: if false;
      allow create, update: if workflowSessionReady('debriefs_alerts') && (hasLegacyAuthSession() || authAppUserId() == appUserId)
        && request.resource.data.keys().hasOnly([
          'reviewedDebriefIds',
          'lastReviewedDebriefId',
          'lastReviewedAt',
          'updatedAt',
          'version'
        ])
        && (!('reviewedDebriefIds' in request.resource.data) || request.resource.data.reviewedDebriefIds is list)
        && validVersionField(request.resource.data);
      allow delete: if false;
    }

    // Audit Logs
    match /auditLogs/{docId} {
      allow read: if (!workflowSecurityEnabled('issues_feedback_audit') && hasLegacyAuthSession())
        || workflowRoleAllowed('issues_feedback_audit', ['admin']);

      allow create: if request.resource.data.keys().hasAll([
        'action', 'collectionPath', 'documentId',
        'performedByUserId', 'performedByName', 'reason'
      ])
        && workflowRoleAllowed('issues_feedback_audit', ['bht', 'tech', 'supervisor', 'admin'])
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && validVersionField(request.resource.data);

      allow update: if false;
      allow delete: if false;
    }

    // EOC Template Library (named templates used by location+shift defaults)
    match /eocTemplateLibrary/{docId} {
      allow read: if workflowRoleAllowed('templates_photos', ['bht', 'tech', 'supervisor', 'admin']);
      allow create, update, delete: if false;
    }

    // EOC Template Assignments (default template per location+shift+type)
    match /eocTemplateAssignments/{docId} {
      allow read: if workflowRoleAllowed('templates_photos', ['bht', 'tech', 'supervisor', 'admin']);
      allow create, update, delete: if false;
    }

    // Legacy EOC Checklist Template
    match /eocChecklistTemplate/{docId} {
      allow read: if workflowRoleAllowed('templates_photos', ['bht', 'tech', 'supervisor', 'admin']);
      allow write: if workflowRoleAllowed('templates_photos', ['admin']);
    }

    // EOC Template Drafts (Draft -> Diff -> Publish workflow)
    match /eocTemplateDrafts/{docId} {
      allow read: if workflowRoleAllowed('templates_photos', ['supervisor', 'admin'])
        && (authRoleAllowed(['admin']) || resource.data.ownerAuthUid == request.auth.uid);
      allow create: if workflowRoleAllowed('templates_photos', ['supervisor', 'admin'])
        && request.resource.data.ownerAuthUid == request.auth.uid
        && request.resource.data.ownerUserId == authAppUserId()
        && validVersionField(request.resource.data);
      allow update: if workflowRoleAllowed('templates_photos', ['supervisor', 'admin'])
        && resource.data.ownerAuthUid == request.auth.uid
        && request.resource.data.ownerAuthUid == resource.data.ownerAuthUid
        && request.resource.data.ownerUserId == resource.data.ownerUserId
        && validVersionField(request.resource.data)
        && createdAtUnchanged();
      allow delete: if workflowRoleAllowed('templates_photos', ['supervisor', 'admin'])
        && (authRoleAllowed(['admin']) || resource.data.ownerAuthUid == request.auth.uid);
    }

    // EOC Template Version History
    match /eocTemplateVersions/{docId} {
      allow read: if workflowRoleAllowed('templates_photos', ['bht', 'tech', 'supervisor', 'admin']);
      allow create, update, delete: if false;
    }

    match /eocSectionLibrary/{docId} {
      allow read: if workflowRoleAllowed('templates_photos', ['supervisor', 'admin']);
      allow create, update, delete: if false;
    }

    match /eocSectionVersions/{docId} {
      allow read: if workflowRoleAllowed('templates_photos', ['supervisor', 'admin']);
      allow create, update, delete: if false;
    }

    match /eocTemplateOperations/{docId} {
      allow read, write: if false;
    }

    match /eocTemplateArchiveRequests/{docId} {
      allow read: if workflowRoleAllowed('templates_photos', ['admin']);
      allow create, update, delete: if false;
    }

    match /eocIssuePatterns/{patternId} {
      allow read: if workflowExactIssueLocationAllowed('eoc', resource.data.locationId);
      allow create, update: if request.resource.data.patternId == patternId
        && request.resource.data.locationId is string
        && request.resource.data.trackingId is string
        && request.resource.data.observations is list
        && request.resource.data.recentCount is int
        && request.resource.data.recentCount >= 0
        && request.resource.data.lifetimeCount is int
        && request.resource.data.lifetimeCount >= request.resource.data.recentCount
        && request.resource.data.reportedBefore is bool
        && request.resource.data.recurringIssue is bool
        && workflowExactIssueLocationAllowed('eoc', request.resource.data.locationId)
        && workflowRoleAllowed('eoc', ['bht', 'tech', 'supervisor', 'admin'])
        && validVersionField(request.resource.data);
      allow delete: if false;

    }

    // EOC Vehicles
    match /eocVehicles/{docId} {
      allow read: if !workflowSecurityEnabled('operations_admin')
        || workflowRoleAllowed('operations_admin', ['bht', 'tech', 'supervisor', 'admin']);
      allow create: if workflowRoleAllowed('operations_admin', ['supervisor', 'admin'])
        && fleetLocationAllowed(request.resource.data)
        && validVersionField(request.resource.data);
      allow update: if workflowRoleAllowed('operations_admin', ['supervisor', 'admin'])
        && fleetLocationAllowed(request.resource.data)
        && validVersionField(request.resource.data)
        && createdAtUnchanged();
      allow delete: if workflowRoleAllowed('operations_admin', ['supervisor', 'admin'])
        && fleetLocationAllowed(resource.data);
    }

    // Property profiles
    match /eocProperties/{docId} {
      allow read: if workflowRoleAllowed('operations_admin', ['supervisor', 'admin'])
        && fleetLocationAllowed(resource.data);
      allow create: if workflowRoleAllowed('operations_admin', ['supervisor', 'admin'])
        && fleetLocationAllowed(request.resource.data)
        && validVersionField(request.resource.data);
      allow update: if workflowRoleAllowed('operations_admin', ['supervisor', 'admin'])
        && fleetLocationAllowed(request.resource.data)
        && validVersionField(request.resource.data)
        && createdAtUnchanged();
      allow delete: if workflowRoleAllowed('operations_admin', ['supervisor', 'admin'])
        && fleetLocationAllowed(resource.data);
    }

    // Fleet maintenance templates
    match /fleetMaintenanceTemplates/{docId} {
      allow read: if !workflowSecurityEnabled('operations_admin')
        || workflowRoleAllowed('operations_admin', ['bht', 'tech', 'supervisor', 'admin']);
      allow create: if workflowRoleAllowed('operations_admin', ['supervisor', 'admin'])
        && fleetLocationAllowed(request.resource.data)
        && validVersionField(request.resource.data);
      allow update: if workflowRoleAllowed('operations_admin', ['supervisor', 'admin'])
        && fleetLocationAllowed(request.resource.data)
        && validVersionField(request.resource.data)
        && createdAtUnchanged();
      allow delete: if workflowRoleAllowed('operations_admin', ['supervisor', 'admin'])
        && fleetLocationAllowed(resource.data);
    }

    // Fleet runtime (strict mileage update path for BHT/tech)
    match /fleetVehicleRuntime/{docId} {
      allow read: if workflowRoleAllowed('operations_admin', ['supervisor', 'admin']);

      allow create: if workflowRoleAllowed('operations_admin', ['bht', 'tech', 'supervisor', 'admin'])
        && request.resource.data.vehicleId is string
        && request.resource.data.lastKnownMileage is int
        && request.resource.data.lastKnownMileage >= 0
        && fleetRuntimeLocationAllowed(request.resource.data)
        && validVersionField(request.resource.data);

      allow update: if workflowRoleAllowed('operations_admin', ['bht', 'tech', 'supervisor', 'admin'])
        && request.resource.data.vehicleId is string
        && request.resource.data.vehicleId == resource.data.vehicleId
        && request.resource.data.lastKnownMileage is int
        && (
          !('lastKnownMileage' in resource.data)
          || request.resource.data.lastKnownMileage >= resource.data.lastKnownMileage
        )
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'vehicleId',
            'mainLocation',
            'lastKnownMileage',
            'lastKnownMileageAt',
            'lastKnownSubmissionId',
            'version',
            'updatedAt'
          ])
        && fleetRuntimeLocationAllowed(request.resource.data)
        && validVersionField(request.resource.data)
        && createdAtUnchanged();

      allow delete: if false;
    }

    // Fleet task queue
    match /fleetTasks/{docId} {
      allow read: if workflowRoleAllowed('operations_admin', ['supervisor', 'admin']);

      allow create: if workflowRoleAllowed('operations_admin', ['supervisor', 'admin'])
        && validFleetTaskType(request.resource.data.taskType)
        && validFleetTaskStatus(request.resource.data.status)
        && validFleetTriggerMode(request.resource.data.triggerMode)
        && fleetLocationAllowed(request.resource.data)
        && validVersionField(request.resource.data);

      allow update: if workflowRoleAllowed('operations_admin', ['supervisor', 'admin'])
        && validFleetTaskType(request.resource.data.taskType)
        && validFleetTaskStatus(request.resource.data.status)
        && validFleetTriggerMode(request.resource.data.triggerMode)
        && fleetLocationAllowed(request.resource.data)
        && validVersionField(request.resource.data)
        && createdAtUnchanged();

      allow delete: if workflowRoleAllowed('operations_admin', ['supervisor', 'admin'])
        && fleetLocationAllowed(resource.data);
    }

    // Vehicle service records
    match /vehicleServiceRecords/{docId} {
      allow read: if workflowRoleAllowed('operations_admin', ['supervisor', 'admin'])
        && fleetLocationAllowed(resource.data);

      allow create: if workflowRoleAllowed('operations_admin', ['supervisor', 'admin'])
        && fleetLocationAllowed(request.resource.data)
        && validVersionField(request.resource.data);

      allow update: if workflowRoleAllowed('operations_admin', ['supervisor', 'admin'])
        && fleetLocationAllowed(request.resource.data)
        && validVersionField(request.resource.data)
        && createdAtUnchanged();

      allow delete: if workflowRoleAllowed('operations_admin', ['admin'])
        && fleetLocationAllowed(resource.data);
    }

    // Compliance collections
    match /complianceEmployees/{employeeId} {
      allow read: if !workflowSecurityEnabled('operations_admin')
        || workflowRoleAllowed('operations_admin', ['supervisor', 'admin']);
      allow write: if workflowRoleAllowed('operations_admin', ['supervisor', 'admin']);
    }
    match /complianceItems/{itemId} {
      allow read: if !workflowSecurityEnabled('operations_admin')
        || workflowRoleAllowed('operations_admin', ['supervisor', 'admin']);
      allow create, update: if workflowRoleAllowed('operations_admin', ['supervisor', 'admin'])
        && (
          authLocationAllowed(request.resource.data.employeeSite)
          || authLocationAllowed(request.resource.data.mainLocation)
          || authLocationAllowed(request.resource.data.locationId)
        );
      allow delete: if workflowRoleAllowed('operations_admin', ['supervisor', 'admin'])
        && (
          authLocationAllowed(resource.data.employeeSite)
          || authLocationAllowed(resource.data.mainLocation)
          || authLocationAllowed(resource.data.locationId)
        );
    }
    match /cintasServices/{serviceId} {
      allow read: if workflowRoleAllowed('operations_admin', ['supervisor', 'admin'])
        && (
          authLocationAllowed(resource.data.mainLocation)
          || authLocationAllowed(resource.data.locationId)
        )
        || (
          workflowRoleAllowed('operations_admin', ['admin'])
          && !('mainLocation' in resource.data)
          && !('locationId' in resource.data)
        );
      allow write: if workflowRoleAllowed('operations_admin', ['supervisor', 'admin'])
        && (
          authLocationAllowed(request.resource.data.mainLocation)
          || authLocationAllowed(request.resource.data.locationId)
        );
    }

    // Transports collection
    match /transports/{transportId} {
      allow read: if !workflowSecurityEnabled('transports')
        || workflowRoleAllowed('transports', ['bht', 'tech', 'supervisor', 'admin']);

      allow create: if request.resource.data.keys().hasAll([
        'site', 'createdByUserId', 'createdByName', 'status', 'departedAt', 'createdAt'
        ])
        && request.resource.data.status in ['open', 'arrived', 'returned', 'closed']
        && request.resource.data.site in ['OTC', 'RES']
        && workflowTransportWriteAllowed(request.resource.data)
        && validVersionField(request.resource.data);

      allow update: if request.resource.data.keys().hasAll([
        'site', 'createdByUserId', 'createdByName', 'status', 'departedAt', 'updatedAt'
        ])
        && request.resource.data.status in ['open', 'arrived', 'returned', 'closed']
        && workflowTransportWriteAllowed(request.resource.data)
        && validVersionField(request.resource.data)
        && request.resource.data.createdByUserId == resource.data.createdByUserId
        && request.resource.data.createdByName == resource.data.createdByName
        && request.resource.data.site == resource.data.site
        && createdAtUnchanged()
        && (
          !(request.resource.data.status in ['returned', 'closed'])
          || (
            request.resource.data.keys().hasAny(['dcPaperworkStatus'])
            && request.resource.data.dcPaperworkStatus in ['collected', 'na', 'other']
            && (
              request.resource.data.dcPaperworkStatus != 'other'
              || (request.resource.data.keys().hasAny(['dcPaperworkOtherNote'])
                  && request.resource.data.dcPaperworkOtherNote is string
                  && request.resource.data.dcPaperworkOtherNote.size() > 0)
            )
          )
        );

      allow delete: if workflowTransportDeleteAllowed(resource.data);
    }

    // App settings
    match /appSettings/{docId} {
      allow read: if workflowSessionReady('settings');
      allow write: if !(docId in ['securityFoundation', 'securityWorkflows', 'appCheckMonitoring'])
        && workflowRoleAllowed('settings', ['admin']);
    }

    // Dormant workflow-by-workflow security boundary. A server-issued, exact
    // versioned token claim selects workflows after the server has read the
    // protected rollout configuration. Current tokens have no such claim, so
    // compatibility behavior is unchanged without adding document reads to
    // already-large Firestore transactions.
    function workflowSecurityEnabled(workflowId) {
      return signedIn()
        && 'workflowSecurityVersion' in request.auth.token
        && 'secureWorkflows' in request.auth.token
        && request.auth.token.workflowSecurityVersion == 6
        && request.auth.token.secureWorkflows is list
        && workflowId in request.auth.token.secureWorkflows;
    }

    function hasCurrentSecuritySession() {
      let profileId = request.auth.token.profileId;
      let sessionPath = /databases/$(database)/documents/staffSessions/$(request.auth.token.sessionId);
      let session = get(sessionPath).data;
      return signedIn()
        && 'profileId' in request.auth.token
        && 'sessionId' in request.auth.token
        && 'securityVersion' in request.auth.token
        && request.auth.token.profileId == profileId
        && request.auth.token.sessionVersion == 2
        && profileId != ''
        && exists(sessionPath)
        && session.active == true
        && session.authUid == request.auth.uid
        && session.profileId == profileId
        && session.securityVersion == request.auth.token.securityVersion
        && session.expiresAt > request.time
        && (!('scopeExpiresAt' in session) || session.scopeExpiresAt == null || session.scopeExpiresAt > request.time)
        && (!('revokedAt' in session) || session.revokedAt == null);
    }

    function workflowTokenRole() {
      return signedIn() && request.auth.token.role is string
        ? request.auth.token.role
        : '';
    }

    function workflowTokenLocations() {
      return signedIn() && request.auth.token.authorizedLocations is list
        ? request.auth.token.authorizedLocations
        : [];
    }

    function workflowTokenIssueLocations() {
      return signedIn() && request.auth.token.issueLocationIds is list
        ? request.auth.token.issueLocationIds
        : [];
    }

    function workflowTokenLocationAllowed(locationId) {
      let locations = workflowTokenLocations();
      let issueLocations = workflowTokenIssueLocations();
      let normalizedLocation = locationScopeAlias(locationId);
      return workflowTokenRole() == 'admin'
        || locationId in locations
        || normalizedLocation in locations
        || locationId in issueLocations;
    }

    function workflowRoleAllowed(workflowId, roles) {
      return workflowSecurityEnabled(workflowId)
        ? (hasCurrentSecuritySession() && workflowTokenRole() in roles)
        : authRoleAllowed(roles);
    }

    function workflowSessionReady(workflowId) {
      return !workflowSecurityEnabled(workflowId) || hasCurrentSecuritySession();
    }

    function workflowLocationAllowed(workflowId, roles, locationId) {
      return workflowSecurityEnabled(workflowId)
        ? (
            hasCurrentSecuritySession()
            && workflowTokenRole() in roles
            && workflowTokenLocationAllowed(locationId)
          )
        : authRoleAndLocationAllowed(roles, locationId);
    }

    function workflowExactIssueLocationAllowed(workflowId, locationId) {
      return workflowSecurityEnabled(workflowId)
        ? (
            hasCurrentSecuritySession()
            && workflowTokenLocationAllowed(locationId)
          )
        : exactIssueLocationAllowed(locationId);
    }

    function workflowTransportWriteAllowed(data) {
      return workflowSecurityEnabled('transports')
        ? (
            hasCurrentSecuritySession()
            && data.site in ['OTC', 'RES']
            && workflowTokenRole() in ['bht', 'tech', 'supervisor', 'admin']
            && workflowTokenLocationAllowed(data.site)
            && (workflowTokenRole() in ['supervisor', 'admin'] || data.createdByUserId == request.auth.token.profileId)
          )
        : authTransportWriteAllowed(data);
    }

    function workflowTransportDeleteAllowed(data) {
      return workflowSecurityEnabled('transports')
        ? (
            hasCurrentSecuritySession()
            && (
              workflowTokenRole() == 'admin'
              || (
                workflowTokenRole() in ['bht', 'tech']
                && data.site in ['OTC', 'RES']
                && workflowTokenLocationAllowed(data.site)
                && data.createdByUserId == request.auth.token.profileId
                && data.status in ['open', 'arrived']
              )
            )
          )
        : authTransportDeleteAllowed(data);
    }

    match /appMetrics/{docId} {
      allow read: if hasLegacyAuthSession() || authRoleAllowed(['admin']);
      allow write: if false;
    }

    // Phase 2 server-only authentication foundation. Cloud Functions use the
    // Admin SDK; no browser role may read credentials, mappings, sessions,
    // rate-limit state, or login audit evidence directly.
    match /staffPinCredentials/{profileId} {
      allow read, write: if false;
    }
    match /staffAuthIdentities/{profileId} {
      allow read, write: if false;
    }
    match /staffSessions/{sessionId} {
      allow read, write: if false;
    }
    match /securityRateLimits/{rateLimitId} {
      allow read, write: if false;
    }
    match /securityLoginAudit/{auditId} {
      allow read, write: if false;
    }
    // Phase 4 protected account actions keep the PIN lookup registry, immutable
    // action evidence, and retryable cleanup state server-only as well.
    match /staffPinLookup/{lookupId} {
      allow read, write: if false;
    }
    match /securityAccountAudit/{auditId} {
      allow read, write: if false;
    }
    match /securityCleanupJobs/{jobId} {
      allow read, write: if false;
    }
    match /securityOfflineReplayAudit/{auditId} {
      allow read, write: if false;
    }
    match /securityWorkflowLocks/{lockId} {
      allow read, write: if false;
    }
    match /securityWorkflowAudit/{auditId} {
      allow read, write: if false;
    }

    // Deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

